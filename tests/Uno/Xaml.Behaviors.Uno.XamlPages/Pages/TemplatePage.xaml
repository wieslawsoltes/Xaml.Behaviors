<UserControl x:Class="Xaml.Behaviors.Uno.XamlPages.Pages.TemplatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core">
  <UserControl.Resources>
    <Style x:Key="CountingButtonStyle" TargetType="Button">
      <Setter Property="i:Interaction.BehaviorsTemplate">
        <Setter.Value>
          <DataTemplate>
            <i:BehaviorCollectionHost>
              <ic:EventTriggerBehavior EventName="Click">
                <ic:InvokeCommandAction Command="{Binding IncrementCommand}" CommandParameter="styled" />
              </ic:EventTriggerBehavior>
            </i:BehaviorCollectionHost>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <Button x:Name="First" Content="First" Style="{StaticResource CountingButtonStyle}" />
    <Button x:Name="Second" Content="Second" Style="{StaticResource CountingButtonStyle}" />
  </StackPanel>
</UserControl>
