<UserControl x:Class="Xaml.Behaviors.Uno.XamlPages.Pages.ItemsRepeaterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             xmlns:icustom="using:Xaml.Interactions.Custom">
  <StackPanel>
    <TextBlock x:Name="PreparedText" />
    <ScrollViewer Height="200">
      <ItemsRepeater x:Name="Repeater" ItemsSource="{x:Bind Items}">
        <i:Interaction.Behaviors>
          <icustom:ItemsControlContainerPreparedTrigger>
            <ic:ChangePropertyAction TargetObject="{x:Bind PreparedText}" PropertyName="Text" Value="prepared" />
          </icustom:ItemsControlContainerPreparedTrigger>
        </i:Interaction.Behaviors>
      </ItemsRepeater>
    </ScrollViewer>
  </StackPanel>
</UserControl>
