<UserControl x:Class="Xaml.Behaviors.Uno.XamlPages.Pages.DataContextPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:pages="using:Xaml.Behaviors.Uno.XamlPages">
  <StackPanel>
    <Border x:Name="Target">
      <i:Interaction.Behaviors>
        <pages:DataContextMessageBehavior Target="{x:Bind MessageText}" />
      </i:Interaction.Behaviors>
    </Border>
    <TextBlock x:Name="MessageText" />
  </StackPanel>
</UserControl>
