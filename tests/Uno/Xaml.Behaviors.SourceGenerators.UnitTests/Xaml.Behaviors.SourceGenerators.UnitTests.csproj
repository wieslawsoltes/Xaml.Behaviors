<Project Sdk="Microsoft.NET.Sdk">

  <!-- Consumes the headless host through a ProjectReference, so import its buildTransitive files like a package consumer would get them. -->
  <Import Project="..\..\..\src\Uno\Xaml.Behaviors.Uno.Headless.Host\buildTransitive\Xaml.Behaviors.Uno.Headless.Host.props" />
  <!-- Same for the source generator package (surfaces XamlBehaviorsSourceGeneratorPlatform). -->
  <Import Project="..\..\..\src\Xaml.Behaviors.SourceGenerators\buildTransitive\Xaml.Behaviors.SourceGenerators.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>False</IsPackable>
    <Nullable>enable</Nullable>
    <AssemblyName>Xaml.Behaviors.Uno.SourceGenerators.UnitTests</AssemblyName>
    <RootNamespace>Xaml.Behaviors.SourceGenerators.UnitTests</RootNamespace>
    <!-- The generated sources are part of what is tested: warnings in them must fail the build. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
  </PropertyGroup>

  <Import Project="..\..\..\build\XUnit.props" />
  <Import Project="..\..\..\build\SignAssembly.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Uno\Xaml.Behaviors.Uno.Headless.XUnit\Xaml.Behaviors.Uno.Headless.XUnit.csproj" />
    <ProjectReference Include="..\..\..\src\Uno\Xaml.Behaviors.Interactivity\Xaml.Behaviors.Interactivity.csproj" />
    <!-- The generator under test, consumed like the package does (analyzer only). -->
    <ProjectReference Include="..\..\..\src\Xaml.Behaviors.SourceGenerators\Xaml.Behaviors.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <Import Project="..\..\..\src\Uno\Xaml.Behaviors.Uno.Headless.Host\buildTransitive\Xaml.Behaviors.Uno.Headless.Host.targets" />

</Project>
