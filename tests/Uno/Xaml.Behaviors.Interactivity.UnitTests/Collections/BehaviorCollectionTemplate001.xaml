<compat:HeadlessTestWindow x:Class="Xaml.Interactivity.UnitTests.BehaviorCollectionTemplate001"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:compat="using:Xaml.Behaviors.Uno.TestCompat"
                           xmlns:i="using:Xaml.Interactivity"
                           xmlns:ic="using:Xaml.Interactions.Core"
                           Title="BehaviorCollectionTemplate001">
  <!--
    WinUI has no style classes and no BehaviorCollectionTemplate: the "red" style is a keyed style applied to the
    buttons and creates the behaviors of each button from Interaction.BehaviorsTemplate (see src/Uno/PORTING.md).
  -->
  <compat:HeadlessTestWindow.Resources>
    <SolidColorBrush x:Key="RedBrush" Color="Red" />
    <Style x:Key="red" TargetType="Button">
      <Setter Property="i:Interaction.BehaviorsTemplate">
        <Setter.Value>
          <DataTemplate>
            <i:BehaviorCollectionHost>
              <ic:EventTriggerBehavior EventName="Click">
                <ic:ChangePropertyAction PropertyName="Background"
                                         Value="{StaticResource RedBrush}" />
              </ic:EventTriggerBehavior>
            </i:BehaviorCollectionHost>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </compat:HeadlessTestWindow.Resources>
  <StackPanel Spacing="8">
    <Button x:Name="TargetButton1" x:FieldModifier="internal" Style="{StaticResource red}" Background="Transparent" Content="Item1" />
    <Button x:Name="TargetButton2" x:FieldModifier="internal" Style="{StaticResource red}" Background="Transparent" Content="Item2" />
    <Button x:Name="TargetButton3" x:FieldModifier="internal" Style="{StaticResource red}" Background="Transparent" Content="Item3" />
  </StackPanel>
</compat:HeadlessTestWindow>
