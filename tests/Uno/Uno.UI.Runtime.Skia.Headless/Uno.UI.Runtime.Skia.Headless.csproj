<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test-only headless (offscreen) Skia host for Uno Platform.
    Vendored from https://github.com/unoplatform/uno (src/Uno.UI.Runtime.Skia.Headless, Apache-2.0)
    because the Uno.WinUI.Runtime.Skia.Headless package is not published on nuget.org yet.
    The assembly name must stay "Uno.UI.Runtime.Skia.Headless": the Uno Skia runtime grants it
    InternalsVisibleTo access. Replace with the official package once it ships.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UnoRuntimeIdentifier>Skia</UnoRuntimeIdentifier>
    <AssemblyName>Uno.UI.Runtime.Skia.Headless</AssemblyName>
    <RootNamespace>Uno.UI.Runtime.Skia.Headless</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the Skia runtime implementation assemblies (they carry the InternalsVisibleTo grants). -->
    <PackageReference Include="Uno.WinUI" VersionOverride="$(UnoWinUIVersion)" ExcludeAssets="compile" />
    <PackageReference Include="Uno.WinRT" VersionOverride="$(UnoWinUIVersion)" ExcludeAssets="compile" />
    <PackageReference Include="Uno.Foundation" VersionOverride="$(UnoWinUIVersion)" ExcludeAssets="compile" />
    <PackageReference Include="Uno.WinUI.Runtime.Skia" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <PropertyGroup>
    <_UnoSkiaRuntimeRoot>$(NuGetPackageRoot)</_UnoSkiaRuntimeRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(NuGetPackageRoot)uno.winui/$(UnoWinUIVersion)/uno-runtime/net10.0/skia/*.dll" />
    <Reference Include="$(NuGetPackageRoot)uno.winrt/$(UnoWinUIVersion)/uno-runtime/net10.0/skia/*.dll" />
    <Reference Include="$(NuGetPackageRoot)uno.foundation/$(UnoWinUIVersion)/uno-runtime/net10.0/skia/*.dll" />
  </ItemGroup>

</Project>
