<Project>
  <!--
    Files of tests/Xaml.Behaviors.Interactions.UnitTests that are not compiled for Uno Platform, one block per folder.
    Pending files are listed under "not ported yet"; files that stay excluded name the reason.
  -->
  <PropertyGroup>
    <UnoSharedTestExcludes></UnoSharedTestExcludes>
  </PropertyGroup>

  <!-- (root): ported. -->

  <!-- Core: ported. -->

  <!-- Custom: not ported yet. -->
  <PropertyGroup>
    <UnoSharedTestExcludes>$(UnoSharedTestExcludes);
      Custom/AnimationAdapterTests.cs;
      Custom/AttachedToVisualTreeLifecycleTests.cs;
      Custom/BindableValidationRule001.axaml.cs;
      Custom/ClickEventTrigger001.axaml.cs;
      Custom/ClickEventTriggerTests.cs;
      Custom/DetachedFromVisualTreeTrigger001.axaml.cs;
      Custom/DetachedFromVisualTreeTriggerTests.cs;
      Custom/ExecuteCommandBehaviorBaseTests.cs;
      Custom/FocusNextElementActionTests.cs;
      Custom/FocusTrapBehaviorTests.cs;
      Custom/InlineEditBehaviorTests.cs;
      Custom/InvokeButtonClickActionTests.cs;
      Custom/RoutedEventTriggerBehaviorTests.cs;
      Custom/ToolTipTriggerTests.cs;
      Custom/UnoPortedControlBehaviorsTests.cs;
      Custom/ValidationRuleTests.cs;
      Custom/WindowClosedRoutedEventWindow.axaml.cs;
      Custom/XmlnsDefinitionRuntimeXamlTests.cs;
    </UnoSharedTestExcludes>
  </PropertyGroup>

  <!-- DragAndDrop: not ported yet. -->
  <PropertyGroup>
    <UnoSharedTestExcludes>$(UnoSharedTestExcludes);
      DragAndDrop/ContextDragBehaviorTests.cs;
      DragAndDrop/ContextDragEscapeWindow.axaml.cs;
      DragAndDrop/ContextDropBehavior001.axaml.cs;
      DragAndDrop/ContextDropBehaviorTests.cs;
      DragAndDrop/DragDropCommandsBehaviorTests.cs;
      DragAndDrop/ManagedContextDropBehaviorTests.cs;
      DragAndDrop/PanelDragBehaviorTests.cs;
      DragAndDrop/PanelDragDrop001.axaml.cs;
      DragAndDrop/TestContextDragBehavior.cs;
      DragAndDrop/TestDropHandler.cs;
      DragAndDrop/VirtualizedContextDragWindow.axaml.cs;
    </UnoSharedTestExcludes>
  </PropertyGroup>

  <!-- Events: ported. -->
</Project>
