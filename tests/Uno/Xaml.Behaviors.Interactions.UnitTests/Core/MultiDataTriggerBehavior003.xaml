<compat:HeadlessTestWindow x:Class="Xaml.Interactions.UnitTests.Core.MultiDataTriggerBehavior003"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:compat="using:Xaml.Behaviors.Uno.TestCompat"
                           xmlns:i="using:Xaml.Interactivity"
                           xmlns:ic="using:Xaml.Interactions.Core"
                           Title="MultiDataTriggerBehavior003"
                           Width="320">
  <StackPanel Margin="16">
    <TextBlock x:Name="TargetTextBlock" x:FieldModifier="internal"
               Text="Red">
      <i:Interaction.Behaviors>
        <ic:MultiDataTriggerBehavior RevertOnFalse="True">
          <ic:MultiDataTriggerBehavior.Conditions>
            <i:Condition Binding="{x:Bind TargetCheckBox.IsChecked, Mode=OneWay}"
                         Value="True" />
            <i:Condition Binding="{x:Bind TargetSlider.Value, Mode=OneWay}"
                         ComparisonCondition="GreaterThanOrEqual"
                         Value="50" />
          </ic:MultiDataTriggerBehavior.Conditions>
          <ic:ChangePropertyAction PropertyName="Text"
                                   Value="Blue" />
          <ic:ChangePropertyAction PropertyName="Text"
                                   Value="Green" />
        </ic:MultiDataTriggerBehavior>
      </i:Interaction.Behaviors>
    </TextBlock>

    <CheckBox x:Name="TargetCheckBox" x:FieldModifier="internal"
              Content="Enabled"
              IsChecked="False"
              Margin="0,8,0,0" />
    <Slider x:Name="TargetSlider" x:FieldModifier="internal"
            Minimum="0"
            Maximum="100"
            SmallChange="25"
            Value="0"
            Margin="0,8,0,0" />
  </StackPanel>
</compat:HeadlessTestWindow>
