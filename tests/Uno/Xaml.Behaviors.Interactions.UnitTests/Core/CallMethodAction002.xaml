<compat:HeadlessTestWindow x:Class="Xaml.Interactions.UnitTests.Core.CallMethodAction002"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:compat="using:Xaml.Behaviors.Uno.TestCompat"
                           xmlns:i="using:Xaml.Interactivity"
                           xmlns:ic="using:Xaml.Interactions.Core"
                           Title="CallMethodAction002">
  <StackPanel>
    <Button x:Name="TargetButton" x:FieldModifier="internal" Content="Button">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Click">
          <ic:CallMethodAction TargetObject="{x:Bind}" MethodName="TestMethod" />
        </ic:EventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
  </StackPanel>
</compat:HeadlessTestWindow>
