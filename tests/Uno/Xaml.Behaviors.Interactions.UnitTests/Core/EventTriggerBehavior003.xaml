<compat:HeadlessTestWindow x:Class="Xaml.Interactions.UnitTests.Core.EventTriggerBehavior003"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:compat="using:Xaml.Behaviors.Uno.TestCompat"
                           xmlns:i="using:Xaml.Interactivity"
                           xmlns:ic="using:Xaml.Interactions.Core"
                           Title="EventTriggerBehavior003">
  <StackPanel>
    <TextBox x:Name="TargetTextBox" x:FieldModifier="internal"
             Text="Initial Text" />
    <Button x:Name="TargetButton" x:FieldModifier="internal" Content="Button">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="DoubleTapped">
          <ic:ChangePropertyAction TargetObject="{Binding ElementName=TargetTextBox}"
                                   PropertyName="Text"
                                   Value="DoubleTapped Text" />
        </ic:EventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
  </StackPanel>
</compat:HeadlessTestWindow>
