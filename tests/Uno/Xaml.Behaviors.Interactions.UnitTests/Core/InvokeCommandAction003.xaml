<compat:HeadlessTestWindow x:Class="Xaml.Interactions.UnitTests.Core.InvokeCommandAction003"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:compat="using:Xaml.Behaviors.Uno.TestCompat"
                           xmlns:i="using:Xaml.Interactivity"
                           xmlns:ic="using:Xaml.Interactions.Core"
                           xmlns:local="using:Xaml.Interactions.UnitTests.Core"
                           Title="InvokeCommandAction003">
  <!-- WinUI XAML has no x:Static: the converter instance is a resource. -->
  <compat:HeadlessTestWindow.Resources>
    <local:TestValueConverter x:Key="TestValueConverter" />
  </compat:HeadlessTestWindow.Resources>
  <StackPanel>
    <TextBox x:Name="TargetTextBox" x:FieldModifier="internal"
             Text="Initial Text" />
    <Button x:Name="TargetButton" x:FieldModifier="internal" Content="Button">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Click">
          <ic:InvokeCommandAction Command="{Binding TestCommand}"
                                  InputConverter="{StaticResource TestValueConverter}"
                                  InputConverterParameter="{x:Null}"
                                  InputConverterLanguage="en-US" />
        </ic:EventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
  </StackPanel>
</compat:HeadlessTestWindow>
