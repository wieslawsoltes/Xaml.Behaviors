<compat:HeadlessTestWindow x:Class="Xaml.Interactions.UnitTests.Core.DataTriggerBehavior003"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:compat="using:Xaml.Behaviors.Uno.TestCompat"
                           xmlns:i="using:Xaml.Interactivity"
                           xmlns:ic="using:Xaml.Interactions.Core"
                           Title="DataTriggerBehavior003">
  <StackPanel>
    <TextBlock x:Name="TargetTextBlock" x:FieldModifier="internal"
               Text="">
      <i:Interaction.Behaviors>
        <ic:DataTriggerBehavior Binding="{x:Bind TargetSlider.Value, Mode=OneWay}"
                                ComparisonCondition="LessThan">
          <ic:DataTriggerBehavior.Value>
            <x:String>50</x:String>
          </ic:DataTriggerBehavior.Value>
          <ic:ChangePropertyAction PropertyName="Text"
                                   Value="Less than 50" />
        </ic:DataTriggerBehavior>
        <ic:DataTriggerBehavior Binding="{x:Bind TargetSlider.Value, Mode=OneWay}"
                                ComparisonCondition="GreaterThanOrEqual">
          <ic:DataTriggerBehavior.Value>
            <x:String>50</x:String>
          </ic:DataTriggerBehavior.Value>
          <ic:ChangePropertyAction PropertyName="Text"
                                   Value="50 or more" />
        </ic:DataTriggerBehavior>
      </i:Interaction.Behaviors>
    </TextBlock>
    <Slider x:Name="TargetSlider" x:FieldModifier="internal"
            Minimum="0"
            Maximum="100"
            SmallChange="25"
            Value="0" />
  </StackPanel>
</compat:HeadlessTestWindow>
