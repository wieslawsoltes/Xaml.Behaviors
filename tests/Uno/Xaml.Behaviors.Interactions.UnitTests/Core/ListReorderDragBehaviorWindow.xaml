<compat:HeadlessTestWindow x:Class="Xaml.Interactions.UnitTests.Core.ListReorderDragBehaviorWindow"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:compat="using:Xaml.Behaviors.Uno.TestCompat"
                           xmlns:i="using:Xaml.Interactivity"
                           xmlns:draggable="using:Xaml.Interactions.Draggable"
                           Width="400"
                           Height="210">
  <!--
    The virtualizing WinUI list is ListView (Uno Platform's ListBox has no ListBoxItem containers); WinUI styles the
    containers through ItemContainerStyle (Avalonia: a ListBoxItem style in ListBox.Styles).
  -->
  <ListView x:Name="TargetListBox" x:FieldModifier="internal">
    <ListView.ItemContainerStyle>
      <Style TargetType="ListViewItem">
        <Setter Property="i:Interaction.BehaviorsTemplate">
          <Setter.Value>
            <DataTemplate>
              <i:BehaviorCollectionHost>
                <draggable:ListReorderDragBehavior Orientation="Vertical" />
              </i:BehaviorCollectionHost>
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ListView.ItemContainerStyle>
  </ListView>
</compat:HeadlessTestWindow>
