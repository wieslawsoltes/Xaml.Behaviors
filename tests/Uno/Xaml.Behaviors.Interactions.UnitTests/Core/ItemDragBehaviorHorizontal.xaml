<compat:HeadlessTestWindow x:Class="Xaml.Interactions.UnitTests.Core.ItemDragBehaviorHorizontal"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:compat="using:Xaml.Behaviors.Uno.TestCompat"
                           xmlns:i="using:Xaml.Interactivity"
                           xmlns:id="using:Xaml.Interactions.Draggable"
                           Title="ItemDragBehaviorHorizontal">
  <ItemsControl x:Name="TargetItemsControl" x:FieldModifier="internal" ItemsSource="{Binding Items}">
    <!-- WinUI styles containers through ItemContainerStyle (Avalonia: an "ItemsControl > ContentPresenter" style). -->
    <ItemsControl.ItemContainerStyle>
      <Style TargetType="ContentPresenter">
        <Setter Property="i:Interaction.BehaviorsTemplate">
          <Setter.Value>
            <DataTemplate>
              <i:BehaviorCollectionHost>
                <id:ItemDragBehavior Orientation="Horizontal" HorizontalDragThreshold="0" VerticalDragThreshold="0" />
              </i:BehaviorCollectionHost>
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ItemsControl.ItemContainerStyle>
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <!-- Top aligned: native WinUI hits a text only container on its text, not on the empty area below it. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
  </ItemsControl>
</compat:HeadlessTestWindow>
