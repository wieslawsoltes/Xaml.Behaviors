<compat:HeadlessTestWindow x:Class="Xaml.Interactions.UnitTests.Core.ItemDragBehaviorVertical"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:compat="using:Xaml.Behaviors.Uno.TestCompat"
                           xmlns:i="using:Xaml.Interactivity"
                           xmlns:id="using:Xaml.Interactions.Draggable"
                           Title="ItemDragBehaviorVertical">
  <!--
    The WinUI list is ListView (Uno Platform's ListBox has no ListBoxItem containers); WinUI styles the containers
    through ItemContainerStyle (Avalonia: a ListBoxItem style in Window.Styles).
  -->
  <ListView x:Name="TargetListBox" x:FieldModifier="internal" ItemsSource="{Binding Items}">
    <ListView.ItemContainerStyle>
      <Style TargetType="ListViewItem">
        <Setter Property="i:Interaction.BehaviorsTemplate">
          <Setter.Value>
            <DataTemplate>
              <i:BehaviorCollectionHost>
                <id:ItemDragBehavior Orientation="Vertical" HorizontalDragThreshold="0" VerticalDragThreshold="0" />
              </i:BehaviorCollectionHost>
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ListView.ItemContainerStyle>
  </ListView>
</compat:HeadlessTestWindow>
