<compat:HeadlessTestWindow x:Class="Xaml.Interactions.UnitTests.DragAndDrop.VirtualizedContextDragWindow"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:compat="using:Xaml.Behaviors.Uno.TestCompat"
                           xmlns:i="using:Xaml.Interactivity"
                           xmlns:local="using:Xaml.Interactions.UnitTests.DragAndDrop"
                           Width="400"
                           Height="210">
  <!--
    A ListView: the Uno Platform ListBox does not generate ListBoxItem containers (its items are hosted in
    ContentPresenters), ListView is the virtualizing selector with item containers (ListViewItem).
  -->
  <ListView x:Name="TargetListBox" x:FieldModifier="internal">
    <ListView.ItemContainerStyle>
      <Style TargetType="ListViewItem">
        <Setter Property="i:Interaction.BehaviorsTemplate">
          <Setter.Value>
            <DataTemplate>
              <i:BehaviorCollectionHost>
                <local:TestContextDragBehavior />
              </i:BehaviorCollectionHost>
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ListView.ItemContainerStyle>
  </ListView>
</compat:HeadlessTestWindow>
