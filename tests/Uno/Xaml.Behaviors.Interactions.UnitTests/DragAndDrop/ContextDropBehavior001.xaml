<compat:HeadlessTestWindow x:Class="Xaml.Interactions.UnitTests.DragAndDrop.ContextDropBehavior001"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:compat="using:Xaml.Behaviors.Uno.TestCompat"
                           xmlns:i="using:Xaml.Interactivity"
                           xmlns:idd="using:Xaml.Interactions.DragAndDrop"
                           xmlns:local="using:Xaml.Interactions.UnitTests.DragAndDrop"
                           Title="ContextDropBehavior001" Width="200" Height="100">
  <compat:HeadlessTestWindow.Resources>
    <local:TestDropHandler x:Key="Handler" />
  </compat:HeadlessTestWindow.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <StackPanel x:Name="LeftPanel" x:FieldModifier="internal" Margin="5">
      <Rectangle x:Name="DragRectangle" x:FieldModifier="internal" Width="20" Height="20" Fill="Blue" Margin="5">
        <i:Interaction.Behaviors>
          <idd:PanelDragBehavior />
        </i:Interaction.Behaviors>
      </Rectangle>
    </StackPanel>
    <Border x:Name="DropBorder" x:FieldModifier="internal" Grid.Column="1" Background="LightGray" Margin="5" Width="100" Height="50">
      <i:Interaction.Behaviors>
        <idd:ContextDropBehavior Handler="{StaticResource Handler}" Context="TargetContext" />
      </i:Interaction.Behaviors>
    </Border>
  </Grid>
</compat:HeadlessTestWindow>
