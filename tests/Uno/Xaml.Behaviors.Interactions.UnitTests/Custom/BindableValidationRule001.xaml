<compat:HeadlessTestWindow x:Class="Xaml.Interactions.UnitTests.Custom.BindableValidationRule001"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:compat="using:Xaml.Behaviors.Uno.TestCompat"
                           xmlns:i="using:Xaml.Interactivity"
                           xmlns:custom="using:Xaml.Interactions.Custom"
                           xmlns:local="using:Xaml.Interactions.UnitTests.Custom">
  <compat:HeadlessTestWindow.DataContext>
    <local:ValidationRuleBindingSource Minimum="0"
                                       Maximum="100"
                                       ErrorMessage="Value must be within the current bounds." />
  </compat:HeadlessTestWindow.DataContext>

  <Slider x:Name="TargetSlider"
          x:FieldModifier="internal"
          Minimum="0"
          Maximum="200"
          Value="50">
    <i:Interaction.Behaviors>
      <custom:SliderValidationBehavior>
        <!--
          WinUI XAML has no x:TypeArguments: DoubleRangeValidationRule is a RangeValidationRule<double>. The rules are
          not in the element tree (no inherited DataContext), so they bind to the DataContext with x:Bind.
        -->
        <local:DoubleRangeValidationRule Minimum="{x:Bind Source.Minimum, Mode=OneWay}"
                                         Maximum="{x:Bind Source.Maximum, Mode=OneWay}"
                                         ErrorMessage="{x:Bind Source.ErrorMessage, Mode=OneWay}" />
      </custom:SliderValidationBehavior>
    </i:Interaction.Behaviors>
  </Slider>
</compat:HeadlessTestWindow>
