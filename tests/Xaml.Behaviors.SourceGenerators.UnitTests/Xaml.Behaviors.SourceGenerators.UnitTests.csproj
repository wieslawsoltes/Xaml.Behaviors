<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <GenerateRuntimeConfigurationFiles>True</GenerateRuntimeConfigurationFiles>
    <IsPackable>False</IsPackable>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);IL2026;IL2072</NoWarn>
    <!-- Keep compiler generated files in obj to avoid polluting the repo -->
    <EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Generated\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- WinUI reference assemblies for compile-only WinUI generator tests (not referenced by the test assembly). -->
    <PackageDownload Include="Uno.WinUI" Version="[$(UnoWinUIVersion)]" />
    <PackageDownload Include="Uno.Foundation" Version="[$(UnoWinUIVersion)]" />
    <PackageDownload Include="Uno.WinRT" Version="[$(UnoWinUIVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <!-- Paths consumed by WinUIGeneratorTestHelper (the test assembly has no generated AssemblyInfo). -->
    <RuntimeHostConfigurationOption Include="Xaml.Behaviors.SourceGenerators.UnitTests.NuGetPackageRoot" Value="$(NuGetPackageRoot)" />
    <RuntimeHostConfigurationOption Include="Xaml.Behaviors.SourceGenerators.UnitTests.UnoWinUIVersion" Value="$(UnoWinUIVersion)" />
  </ItemGroup>

  <Import Project="..\..\build\XUnit.props" />
  <Import Project="..\..\build\SignAssembly.props" />

  <Target Name="ClearCoreCompileCache" BeforeTargets="CoreCompile">
    <Delete Files="$(IntermediateOutputPath)$(MSBuildProjectFile).CoreCompileInputs.cache" ContinueOnError="true" />
    <Delete Files="$(IntermediateOutputPath)$(MSBuildProjectName).CoreCompileInputs.cache" ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Xaml.Behaviors.Interactivity\Xaml.Behaviors.Interactivity.csproj" />
    <!-- Consume the generator for both compilation (to access the type) and analyzer execution, without flowing transitively -->
    <ProjectReference Include="..\..\src\Xaml.Behaviors.SourceGenerators\Xaml.Behaviors.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true"
                      PrivateAssets="all" />
    <!-- Built for the compile-only WinUI generator tests; its path is passed to the tests, it is not referenced. -->
    <ProjectReference Include="..\..\src\Uno\Xaml.Behaviors.Interactivity\Xaml.Behaviors.Interactivity.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="UnoInteractivityAssembly"
                      PrivateAssets="all" />
  </ItemGroup>

  <Target Name="AddUnoInteractivityAssemblyPath" AfterTargets="ResolveProjectReferences">
    <ItemGroup>
      <RuntimeHostConfigurationOption Include="Xaml.Behaviors.SourceGenerators.UnitTests.UnoInteractivityAssembly" Value="%(UnoInteractivityAssembly.FullPath)" Condition="'@(UnoInteractivityAssembly)' != ''" />
    </ItemGroup>
  </Target>

</Project>
