<!--
  The application of the WinUI test projects: the XAML compiler generates the XAML type information of the test
  assembly (the types of its XAML test pages and of the behaviors they use) for it.
-->
<Application x:Class="Xaml.Behaviors.WinUI.TestCompat.TestApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
