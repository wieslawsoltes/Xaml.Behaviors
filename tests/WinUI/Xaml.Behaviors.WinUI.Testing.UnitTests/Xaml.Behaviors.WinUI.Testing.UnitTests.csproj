<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of the WinUI test harness: the tests of the Uno Platform headless harness (tests/Uno/Xaml.Behaviors.Uno.Headless.UnitTests)
    run against the WinUI harness, with a WinUI test session fixture (TestSessionFixture.cs next to this project).
  -->
  <PropertyGroup>
    <AssemblyName>Xaml.Behaviors.WinUI.Testing.UnitTests</AssemblyName>
    <RootNamespace>Xaml.Behaviors.WinUI.Testing.UnitTests</RootNamespace>
    <WinUIUnoTestProject>Xaml.Behaviors.Uno.Headless.UnitTests</WinUIUnoTestProject>
    <WinUITestsTrackWindows>false</WinUITestsTrackWindows>
    <WinUIUnoTestExcludes>
      <!-- Replaced by the WinUI fixture: the WinUI test application must load the control resources. -->
      TestSessionFixture.cs
    </WinUIUnoTestExcludes>
  </PropertyGroup>

  <Import Project="..\WinUISharedTests.targets" />

</Project>
