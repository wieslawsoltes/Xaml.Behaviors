<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinUI 3 twin of tests/Uno/Xaml.Behaviors.Interactions.UnitTests: compiles its sources (see tests/WinUI/WinUISharedTests.targets). -->
  <PropertyGroup>
    <AssemblyName>Xaml.Behaviors.WinUI.Interactions.UnitTests</AssemblyName>
    <RootNamespace>Xaml.Interactions.UnitTests</RootNamespace>
    <WinUIUnoTestProject>Xaml.Behaviors.Interactions.UnitTests</WinUIUnoTestProject>
    <UnoSharedTestProject>Xaml.Behaviors.Interactions.UnitTests</UnoSharedTestProject>
    <WinUIUnoTestExcludes>
      <!-- The Uno fixture loads the control resources in the application constructor; the WinUI test application loads them (AssemblyInfo.cs next to this project). -->
      AssemblyInfo.cs
    </WinUIUnoTestExcludes>
  </PropertyGroup>

  <Import Project="..\..\..\build\XamlPropertyGenerator.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\WinUI\Xaml.Behaviors.Interactivity\Xaml.Behaviors.Interactivity.csproj" />
    <ProjectReference Include="..\..\..\src\WinUI\Xaml.Behaviors.Interactions\Xaml.Behaviors.Interactions.csproj" />
    <ProjectReference Include="..\..\..\src\WinUI\Xaml.Behaviors.Interactions.Custom\Xaml.Behaviors.Interactions.Custom.csproj" />
    <ProjectReference Include="..\..\..\src\WinUI\Xaml.Behaviors.Interactions.DragAndDrop\Xaml.Behaviors.Interactions.DragAndDrop.csproj" />
    <ProjectReference Include="..\..\..\src\WinUI\Xaml.Behaviors.Interactions.Draggable\Xaml.Behaviors.Interactions.Draggable.csproj" />
    <ProjectReference Include="..\..\..\src\WinUI\Xaml.Behaviors.Interactions.Events\Xaml.Behaviors.Interactions.Events.csproj" />
    <ProjectReference Include="..\..\..\src\WinUI\Xaml.Behaviors.Interactions.Responsive\Xaml.Behaviors.Interactions.Responsive.csproj" />
  </ItemGroup>

  <Import Project="..\WinUISharedTests.targets" />

</Project>
