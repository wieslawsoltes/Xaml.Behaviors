<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <RootNamespace>Xaml.PropertyGenerator.CodeFixes</RootNamespace>
    <!-- Packed into the Xaml.PropertyGenerator package next to the generator/analyzer assembly. -->
    <NoWarn>$(NoWarn);RS1038</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xaml.PropertyGenerator\Xaml.PropertyGenerator.csproj" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="..\..\build\SignAssembly.props" />

</Project>
