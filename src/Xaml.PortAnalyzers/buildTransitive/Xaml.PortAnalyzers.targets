<Project>
  <!--
    Xaml.PortAnalyzers: the generated analyzer config file stores one value per line and treats ';' and '#' as the
    start of a comment, so list properties are rewritten before it is generated:
      - line breaks (a common way to format long lists) are removed,
      - ';' separators become '|' (the analyzers accept ';', '|' and, for symbols, ',' and white space).
  -->
  <Target Name="_XamlPortNormalizeAnalyzerProperties" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;GenerateMSBuildEditorConfigFile">
    <PropertyGroup>
      <XamlPortSharedSourceExcludes Condition="'$(XamlPortSharedSourceExcludes)' != ''">$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace($([System.Text.RegularExpressions.Regex]::Replace('$(XamlPortSharedSourceExcludes)', '\s*[\r\n]+\s*', '')), '\s*;\s*', '|'))))</XamlPortSharedSourceExcludes>
      <XamlPortKnownSymbols Condition="'$(XamlPortKnownSymbols)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(XamlPortKnownSymbols)', '[\s;]+', ','))</XamlPortKnownSymbols>
      <XamlPortTargetSymbol Condition="'$(XamlPortTargetSymbol)' != ''">$(XamlPortTargetSymbol.Trim())</XamlPortTargetSymbol>
    </PropertyGroup>
  </Target>
</Project>
