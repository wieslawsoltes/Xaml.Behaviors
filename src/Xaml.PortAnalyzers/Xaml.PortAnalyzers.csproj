<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Nullable>enable</Nullable>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Xaml.PortAnalyzers</PackageId>
    <Description>Roslyn analyzers and code fixes that keep Avalonia sources shared with an Uno Platform / WinUI port (compiled with a port preprocessor symbol such as UNO) portable, catching port breakage while building the Avalonia projects.</Description>
    <PackageTags>Avalonia;Uno;UnoPlatform;WinUI;Port;Porting;Portability;Analyzer;Roslyn;CodeFix;Xaml</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128;RS2007</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_XamlPortAddCodeFixesToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn 4.8 (VS 17.8 / .NET 8 SDK) is the minimum compiler host the package supports. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built first and packed next to the analyzer assembly; never referenced by the analyzers themselves. -->
    <ProjectReference Include="..\Xaml.PortAnalyzers.CodeFixes\Xaml.PortAnalyzers.CodeFixes.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Xaml.PortAnalyzers.UnitTests" Key="" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(TargetDir)$(AssemblyName).pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    <None Include="buildTransitive\Xaml.PortAnalyzers.props" Pack="true" PackagePath="buildTransitive" />
    <None Include="buildTransitive\Xaml.PortAnalyzers.targets" Pack="true" PackagePath="buildTransitive" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="xamlport.schema.json" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <!-- Packs the code fix assembly (built by the ProjectReference above) into analyzers/dotnet/cs. -->
  <Target Name="_XamlPortAddCodeFixesToPackage">
    <MSBuild Projects="..\Xaml.PortAnalyzers.CodeFixes\Xaml.PortAnalyzers.CodeFixes.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_XamlPortCodeFixAssembly" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_XamlPortCodeFixAssembly)" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="@(_XamlPortCodeFixAssembly->'%(RootDir)%(Directory)%(Filename).pdb')"
                              Condition="Exists('%(RootDir)%(Directory)%(Filename).pdb')"
                              PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <Import Project="..\..\build\SignAssembly.props" />
  <Import Project="..\..\build\SourceLink.props" />

</Project>
