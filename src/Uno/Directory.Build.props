<Project>
  <!-- Shared settings for all Uno Platform port projects (src/Uno/**). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <UnoTargetFrameworks>net10.0</UnoTargetFrameworks>
    <UnoRootDirectory>$(MSBuildThisFileDirectory)</UnoRootDirectory>
    <!-- Root of the Avalonia projects whose sources are shared (source linked) with the Uno port. -->
    <AvaloniaSourcesDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))/</AvaloniaSourcesDirectory>
    <DefineConstants>$(DefineConstants);UNO</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Libraries do not need the app-level implicit packages of the Uno.Sdk. -->
    <UnoFeatures></UnoFeatures>
    <PackageTags>Uno;UnoPlatform;WinUI;Behavior;Action;Behaviors;Actions;Managed;C#;Interaction;Interactivity;Interactions;Xaml</PackageTags>
  </PropertyGroup>

  <!--
    Type aliases that let the shared (Avalonia-first) sources compile against WinUI.
    They only exist in Uno builds; see src/Uno/PORTING.md.
    Projects that do not share Avalonia sources (e.g. the headless test packages) opt out with
    <UnoPortAliases>false</UnoPortAliases>; item conditions are evaluated after all properties,
    so setting the property in the project file is enough.
  -->
  <ItemGroup Condition="'$(UnoPortAliases)' != 'false'">
    <Using Include="Microsoft.UI.Xaml.DependencyObject" Alias="AvaloniaObject" />
    <Using Include="Microsoft.UI.Xaml.DependencyPropertyChangedEventArgs" Alias="AvaloniaPropertyChangedEventArgs" />
    <!--
      Avalonia element hierarchy mapped to its closest WinUI counterparts. In the shared sources these names
      always refer to Avalonia types, so the aliases intentionally win over WinUI's own Control type.
      Uno-only files use fully qualified names when they need Microsoft.UI.Xaml.Controls.Control.
    -->
    <Using Include="Microsoft.UI.Xaml.FrameworkElement" Alias="Control" />
    <Using Include="Microsoft.UI.Xaml.FrameworkElement" Alias="StyledElement" />
    <Using Include="Microsoft.UI.Xaml.FrameworkElement" Alias="Layoutable" />
    <Using Include="Microsoft.UI.Xaml.UIElement" Alias="Visual" />
    <Using Include="Microsoft.UI.Xaml.UIElement" Alias="InputElement" />
    <Using Include="Microsoft.UI.Xaml.UIElement" Alias="Interactive" />
  </ItemGroup>
</Project>
