<Project>
  <!--
    Files of src/Xaml.Behaviors.Interactions.Custom that are not compiled for Uno Platform (see src/Uno/PORTING.md).
    Imported by the Uno project (source linking) and by the Avalonia project (Xaml.PortAnalyzers).
    The port proceeds folder by folder: remove a folder from this list once it is ported.
  -->
  <PropertyGroup>
    <UnoSharedSourceExcludes>
      Actions/**;
      Animations/**;
      Behaviors/**;
      Button/**;
      Collections/**;
      Composition/**;
      Control/**;
      Converters/**;
      Core/**;
      Cursor/**;
      Debugging/**;
      ExecuteCommand/**;
      Focus/**;
      Gestures/**;
      Icon/**;
      Input/**;
      InputElement/**;
      Logic/**;
      Transitions/**;
      Validation/**;
      ViewModel/**;
    </UnoSharedSourceExcludes>

    <!--
      Control specific folders: files that derive from Core base types (AttachedToVisualTreeBehavior<T>,
      AttachedToVisualTreeTriggerBase<T>, RoutedEventTriggerBase<T>, RoutedEventTrigger). Their Uno code paths are
      ready; enable them once Core/** is ported.
    -->
    <UnoSharedSourceExcludes>$(UnoSharedSourceExcludes)
      AutoCompleteBox/AutoCompleteBoxOpenDropDownOnFocusBehavior.cs;
      AutoCompleteBox/AutoCompleteBoxSelectionChangedTrigger.cs;
      AutoCompleteBox/FocusAutoCompleteBoxTextBoxBehavior.cs;
      Carousel/CarouselSelectionChangedTrigger.cs;
      ContextDialogs/ContextDialogBehavior.cs;
      ContextDialogs/HideContextDialogAction.cs;
      ContextDialogs/ShowContextDialogAction.cs;
      ItemsControl/ScrollToItemBehavior.cs;
      ItemsControl/ScrollToItemIndexBehavior.cs;
      ListBox/ListBoxSelectAllBehavior.cs;
      ListBox/ListBoxUnselectAllBehavior.cs;
      ScrollViewer/ScrollChangedTrigger.cs;
      ScrollViewer/ScrollViewerOffsetBehavior.cs;
      ScrollViewer/ViewportBehavior.cs;
      Show/**;
      TabControl/TabControlSelectionChangedTrigger.cs;
      TextBox/TextBoxSelectAllTextBehavior.cs;
      ThemeVariant/ThemeVariantBehavior.cs;
      ToolTips/ToolTipClosingTrigger.cs;
      ToolTips/ToolTipOpeningTrigger.cs;
      Window/WindowStateTrigger.cs;
    </UnoSharedSourceExcludes>

    <!--
      Control specific folders: Avalonia concepts without a WinUI counterpart.
      - ItemsControlPreparingContainerTrigger: WinUI items hosts (ItemsRepeater) raise no event before a container is
        prepared.
      - Notifications: Avalonia notification managers (WindowNotificationManager, NotificationCard).
      - RenderTarget renderers: immediate mode drawing (DrawingContext) into a bitmap; WinUI RenderTargetBitmap only
        captures elements.
      - Screen: Avalonia Screens; the WinUI DisplayArea API is not implemented by Uno Platform.
      - CenterWindowBehavior: needs the screen working area (DisplayArea / DisplayInformation screen size are not
        implemented by Uno Platform Skia).
      - WindowDragMoveBehavior: Window.BeginMoveDrag; WinUI declares drag regions with Window.SetTitleBar.
    -->
    <UnoSharedSourceExcludes>$(UnoSharedSourceExcludes)
      ItemsControl/ItemsControlPreparingContainerTrigger.cs;
      Notifications/**;
      RenderTarget/Contract/IRenderTargetBitmapRenderer.cs;
      RenderTarget/Contract/IRenderTargetBitmapSimpleRenderer.cs;
      RenderTarget/RenderTargetBitmapBehavior.cs;
      RenderTarget/StaticRenderTargetBitmapBehavior.cs;
      Screen/**;
      Window/CenterWindowBehavior.cs;
      Window/WindowDragMoveBehavior.cs
    </UnoSharedSourceExcludes>

    <!-- Replaced by Uno Platform implementations next to the Uno project (same relative path). -->
    <UnoSharedSourceExcludes>$(UnoSharedSourceExcludes);
      TreeView/TreeViewFilterHelper.cs
    </UnoSharedSourceExcludes>
  </PropertyGroup>
</Project>
