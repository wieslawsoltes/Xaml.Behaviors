<Project>
  <!--
    Files of src/Xaml.Behaviors.Interactions.Custom that are not compiled for Uno Platform (see src/Uno/PORTING.md).
    Imported by the Uno project (source linking) and by the Avalonia project (Xaml.PortAnalyzers).
    The port proceeds folder by folder: remove a folder from this list once it is ported.
  -->
  <PropertyGroup>
    <UnoSharedSourceExcludes>
      Animations/**;
      AutoCompleteBox/**;
      Automation/**;
      Carousel/**;
      Composition/**;
      ContextDialogs/**;
      Dialog/**;
      FileUpload/**;
      ItemsControl/**;
      Layout/**;
      ListBox/**;
      ListBoxItem/**;
      Multimedia/**;
      Notifications/**;
      Popup/**;
      RenderTarget/**;
      Screen/**;
      ScrollViewer/**;
      SelectingItemsControl/**;
      Show/**;
      SplitView/**;
      System/**;
      TabControl/**;
      TextBox/**;
      ThemeVariant/**;
      ToolTips/**;
      Transitions/**;
      TreeView/**;
      TreeViewItem/**;
      Window/**;
      WriteableBitmap/**
    </UnoSharedSourceExcludes>
  </PropertyGroup>
  <!-- General purpose folders: files without a WinUI counterpart (see src/Uno/PORTING.md). -->
  <PropertyGroup>
    <UnoSharedSourceExcludes>
      $(UnoSharedSourceExcludes);
      <!-- Avalonia style classes (StyledElement.Classes) have no WinUI counterpart. -->
      Actions/AddClassAction.cs;
      Actions/RemoveClassAction.cs;
      Actions/ToggleClassAction.cs;
      <!-- Needs RenderTargetBitmap encoding and TopLevel.StorageProvider (pending, like the Interactions StorageProvider port). -->
      Actions/ScreenshotAction.cs;
      <!-- WinUI raises no ResourcesChanged notification. -->
      Core/ResourcesChangedBehavior.cs;
      Core/ResourcesChangedTrigger.cs;
      <!-- WinUI only exposes the element cursor through the protected UIElement.ProtectedCursor. -->
      Cursor/**;
      <!-- Adorner layer based highlighting; WinUI has no adorners. -->
      Debugging/VisualDebugAdorner.cs;
      Debugging/VisualDebugBehavior.cs;
      <!-- Avalonia gesture recognizer and IME events without a WinUI routed event. -->
      ExecuteCommand/ExecuteCommandOnPinch*.cs;
      ExecuteCommand/ExecuteCommandOnPullGesture*.cs;
      ExecuteCommand/ExecuteCommandOnScrollGesture*.cs;
      ExecuteCommand/ExecuteCommandOnPointerTouchPadGesture*.cs;
      ExecuteCommand/ExecuteCommandOnTextInputMethodClientRequestedBehavior.cs;
      Gestures/Pinch*.cs;
      Gestures/PullGesture*.cs;
      Gestures/ScrollGesture*.cs;
      Gestures/PointerTouchPadGesture*.cs;
      InputElement/Triggers/TextInputMethodClientRequestedTrigger.cs;
      <!-- Replaced by a FocusManager based helper next to the Uno project. -->
      Focus/FocusNavigationHelper.cs;
      <!-- WinUI has no NumericUpDown (NumberBox values are double). -->
      Validation/NumericUpDownValidationBehavior.cs
    </UnoSharedSourceExcludes>
  </PropertyGroup>
</Project>
