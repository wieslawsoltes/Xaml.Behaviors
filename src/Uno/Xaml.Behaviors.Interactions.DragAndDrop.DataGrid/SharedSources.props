    Files of src/Xaml.Behaviors.Interactions.DragAndDrop.DataGrid that are not compiled for Uno Platform
    (see src/Uno/PORTING.md). Imported by the Uno project (source linking) and by the Avalonia project
    (Xaml.PortAnalyzers). All sources are shared; on Uno Platform they target the Windows Community Toolkit DataGrid.
  -->
  <PropertyGroup>
    <UnoSharedSourceExcludes></UnoSharedSourceExcludes>
  </PropertyGroup>
</Project>
