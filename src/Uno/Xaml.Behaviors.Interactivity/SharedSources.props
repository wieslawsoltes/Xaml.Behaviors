<Project>
  <!--
    Files of src/Xaml.Behaviors.Interactivity that are not compiled for Uno Platform (see src/Uno/PORTING.md).
    Imported by the Uno project (source linking) and by the Avalonia project (Xaml.PortAnalyzers), so both
    builds agree on which sources are shared. Uno replacements live next to the Uno project file.
  -->
  <PropertyGroup>
    <UnoSharedSourceExcludes>
      AvaloniaObjectBehaviorsExtensions.cs;
      Templates/**;
      StyledElement/StyledElementBehavior.cs;
      StyledElement/StyledElementTrigger.cs;
      StyledElement/StyledElementAction.cs;
      Helpers/TemplatedParentHelper.cs;
      Helpers/CommandCanExecuteIsEnabledBinder.cs;
      Helpers/ParseHelper.cs;
      Events/Handlers/MenuItemClickEventHandler.cs;
      Events/Handlers/ButtonClickEventHandler.cs;
      Events/Handlers/FlyoutEventHandler.cs;
      Events/RoutedEventHandlerExtensions.cs;
      Events/RoutingStrategiesAdapter.cs
    </UnoSharedSourceExcludes>
  </PropertyGroup>
</Project>
