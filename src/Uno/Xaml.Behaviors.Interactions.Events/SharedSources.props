<Project>
  <!--
    Files of src/Xaml.Behaviors.Interactions.Events that are not compiled for Uno Platform (see src/Uno/PORTING.md).
    Imported by the Uno project (source linking) and by the Avalonia project (Xaml.PortAnalyzers).
  -->
  <PropertyGroup>
    <!-- Avalonia specific gestures without a WinUI routed event. -->
    <UnoSharedSourceExcludes>
      ScrollGesture*.cs;
      TextInputMethodClientRequested*.cs
    </UnoSharedSourceExcludes>
  </PropertyGroup>
</Project>
