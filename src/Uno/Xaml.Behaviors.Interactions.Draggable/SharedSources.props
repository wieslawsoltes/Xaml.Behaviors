<Project>
  <!--
    Files of src/Xaml.Behaviors.Interactions.Draggable that are not compiled for Uno Platform (see src/Uno/PORTING.md).
    Imported by the Uno project (source linking) and by the Avalonia project (Xaml.PortAnalyzers).
  -->
  <PropertyGroup>
    <!--
      SelectionAdorner: an Avalonia adorner drawn in Control.Render(DrawingContext) for the AdornerLayer; WinUI has
      neither immediate mode rendering nor an adorner layer (and the drag behaviors do not use it).
    -->
    <UnoSharedSourceExcludes>
      SelectionAdorner.cs
    </UnoSharedSourceExcludes>
  </PropertyGroup>
</Project>
