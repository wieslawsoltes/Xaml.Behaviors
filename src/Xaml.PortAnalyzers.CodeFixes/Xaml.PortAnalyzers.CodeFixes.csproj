<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Shipped inside the Xaml.PortAnalyzers package (see ..\Xaml.PortAnalyzers\Xaml.PortAnalyzers.csproj). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn 4.8 (VS 17.8 / .NET 8 SDK) is the minimum compiler host the package supports. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Diagnostic ids are shared by source so the code fixes do not depend on the analyzer assembly. -->
    <Compile Include="..\Xaml.PortAnalyzers\DiagnosticIds.cs" Link="DiagnosticIds.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Xaml.PortAnalyzers.UnitTests" Key="" />
  </ItemGroup>

  <Import Project="..\..\build\SignAssembly.props" />
  <Import Project="..\..\build\SourceLink.props" />

</Project>
