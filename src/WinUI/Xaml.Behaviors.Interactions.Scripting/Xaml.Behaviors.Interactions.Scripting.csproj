<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinUI 3 (Windows App SDK) twin of src/Uno/Xaml.Behaviors.Interactions.Scripting: compiles its sources (see src/WinUI/Directory.Build.targets). -->

  <PropertyGroup>
    <TargetFrameworks>$(WinUITargetFrameworks)</TargetFrameworks>
    <AssemblyName>Xaml.Behaviors.WinUI.Interactions.Scripting</AssemblyName>
    <RootNamespace>Xaml.Interactions.Scripting</RootNamespace>
    <WinUIUnoProject>Xaml.Behaviors.Interactions.Scripting</WinUIUnoProject>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Xaml.Behaviors.WinUI.Interactions.Scripting</PackageId>
    <Description>Execute C# scripts at runtime to add dynamic behavior on WinUI 3 (Windows App SDK).</Description>
    <PackageTags>WinUI;WinUI3;WindowsAppSDK;Behavior;Action;Scripting;Roslyn;Xaml</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xaml.Interactivity" />
  </ItemGroup>

  <!--
    Roslyn scripting compiles and runs code at runtime: it works where the runtime supports dynamic code
    (Skia desktop/headless, JIT based targets), not on AOT-only targets (iOS, WebAssembly AOT).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xaml.Behaviors.Interactivity\Xaml.Behaviors.Interactivity.csproj" />
  </ItemGroup>

</Project>
