<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinUI 3 (Windows App SDK) twin of src/Uno/Xaml.Behaviors.Interactivity: compiles its sources (see src/WinUI/Directory.Build.targets). -->

  <PropertyGroup>
    <TargetFrameworks>$(WinUITargetFrameworks)</TargetFrameworks>
    <AssemblyName>Xaml.Behaviors.WinUI.Interactivity</AssemblyName>
    <RootNamespace>Xaml.Interactivity</RootNamespace>
    <WinUIUnoProject>Xaml.Behaviors.Interactivity</WinUIUnoProject>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Xaml.Behaviors.WinUI.Interactivity</PackageId>
    <Description>Foundation library providing base classes for actions, triggers and behaviors for WinUI 3 (Windows App SDK).</Description>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xaml.Interactivity" />
  </ItemGroup>

</Project>
