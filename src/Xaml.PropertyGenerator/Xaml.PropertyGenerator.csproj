<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Nullable>enable</Nullable>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <RootNamespace>Xaml.PropertyGenerator</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Xaml.PropertyGenerator</PackageId>
    <Description>Source generator that turns attributed partial properties into Avalonia styled/direct/attached properties or WinUI/Uno Platform dependency properties, so the same source compiles for both frameworks.</Description>
    <PackageTags>Avalonia;Uno;UnoPlatform;WinUI;DependencyProperty;StyledProperty;SourceGenerator;Porting;Xaml</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>$(NoWarn);NU5128;RS2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="buildTransitive/**" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <Import Project="..\..\build\SignAssembly.props" />
  <Import Project="..\..\build\SourceLink.props" />

  <PropertyGroup>
    <!-- Analyzer-only package: there is no lib assembly to produce a symbols package for. -->
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

</Project>
