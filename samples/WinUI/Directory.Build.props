<Project>
  <!--
    Shared settings of the WinUI 3 samples (samples/WinUI/**): unpackaged applications with a self-contained Windows App
    SDK, so they run directly (dotnet run or the executable) without installing a runtime. See samples/WinUI/README.md.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CS8974: a method group passed as object (WinUI UIElement.RemoveHandler); see src/Uno/PORTING.md. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8974</WarningsAsErrors>
    <UnoRootDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../src/Uno'))/</UnoRootDirectory>
    <!-- The resource index (makepri.exe) is a Windows tool: compile-only builds on other systems skip it. -->
    <AppxGeneratePriEnabled Condition="'$(OS)' != 'Windows_NT'">false</AppxGeneratePriEnabled>
  </PropertyGroup>
</Project>
