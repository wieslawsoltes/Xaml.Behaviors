<UserControl x:Class="SourceGeneratorSample.Views.Pages.AsyncObservableTriggerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:vm="using:SourceGeneratorSample.ViewModels">
  <StackPanel Spacing="12">
    <TextBlock Text="Async/Observable Triggers" FontWeight="Bold" />

    <StackPanel Spacing="6">
      <TextBlock Text="Async Trigger" FontWeight="SemiBold" />
      <Button Content="Start Demo Task" Command="{x:Bind ViewModel.StartDemoTaskCommand}" />
      <TextBlock Text="{x:Bind ViewModel.AsyncTriggerStatus, Mode=OneWay}" />
      <i:Interaction.Behaviors>
        <vm:DemoTaskAsyncTrigger DemoTask="{x:Bind ViewModel.DemoTask, Mode=OneWay}">
          <vm:SetStatusTextAction TargetObject="{x:Bind ViewModel}" Value="Async trigger fired" />
        </vm:DemoTaskAsyncTrigger>
      </i:Interaction.Behaviors>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="Observable Trigger" FontWeight="SemiBold" />
      <Button Content="Start Demo Observable" Command="{x:Bind ViewModel.StartDemoObservableCommand}" />
      <TextBlock Text="{x:Bind ViewModel.ObservableTriggerStatus, Mode=OneWay}" />
      <i:Interaction.Behaviors>
        <vm:DemoObservableObservableTrigger DemoObservable="{x:Bind ViewModel.DemoObservable, Mode=OneWay}">
          <vm:SetProcessingMessageAction TargetObject="{x:Bind ViewModel}" Value="Observable emitted" />
        </vm:DemoObservableObservableTrigger>
      </i:Interaction.Behaviors>
    </StackPanel>
  </StackPanel>
</UserControl>
