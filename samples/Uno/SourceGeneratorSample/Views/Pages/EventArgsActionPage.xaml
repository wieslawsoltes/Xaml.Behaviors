<UserControl x:Class="SourceGeneratorSample.Views.Pages.EventArgsActionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             xmlns:vm="using:SourceGeneratorSample.ViewModels">
  <!--
    WinUI twin of EventArgsActionPage.axaml. The generated actions receive the WinUI event arguments
    (PointerRoutedEventArgs, KeyRoutedEventArgs); see the Uno Platform notes in MainViewModel.
  -->
  <StackPanel Spacing="12">
    <TextBlock Text="EventArgs Actions" FontWeight="Bold" />

    <StackPanel Spacing="6">
      <TextBlock Text="PointerPressed" FontWeight="SemiBold" />
      <Border Background="#FFEFEFEF"
              MinHeight="80"
              CornerRadius="4"
              Padding="12">
        <i:Interaction.Behaviors>
          <ic:EventTriggerBehavior EventName="PointerPressed">
            <vm:OnPointerPressedEventArgsAction TargetObject="{x:Bind ViewModel}" />
          </ic:EventTriggerBehavior>
        </i:Interaction.Behaviors>
        <TextBlock Text="Tap or click anywhere in this box" />
      </Border>
      <TextBlock Text="{x:Bind ViewModel.PointerStatus, Mode=OneWay}" />
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="KeyDown" FontWeight="SemiBold" />
      <TextBox PlaceholderText="Focus here and press any key"
               MinHeight="36">
        <i:Interaction.Behaviors>
          <ic:EventTriggerBehavior EventName="KeyDown">
            <vm:OnKeyCapturedEventArgsAction TargetObject="{x:Bind ViewModel}" />
          </ic:EventTriggerBehavior>
        </i:Interaction.Behaviors>
      </TextBox>
      <TextBlock Text="{x:Bind ViewModel.KeyStatus, Mode=OneWay}" />
    </StackPanel>
  </StackPanel>
</UserControl>
