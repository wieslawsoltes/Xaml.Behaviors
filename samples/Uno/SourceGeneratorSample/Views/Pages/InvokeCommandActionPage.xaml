<UserControl x:Class="SourceGeneratorSample.Views.Pages.InvokeCommandActionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:vm="using:SourceGeneratorSample.ViewModels"
             xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
  <StackPanel Spacing="10">
    <TextBlock Text="InvokeCommandAction" FontWeight="Bold" />
    <Button Content="Typed Command Action">
      <i:Interaction.Behaviors>
        <primitives:ButtonBaseClickTrigger>
          <vm:TypedCommandAction Command="{x:Bind ViewModel.TriggerExternalCommand}" CommandParameter="Test" />
        </primitives:ButtonBaseClickTrigger>
      </i:Interaction.Behaviors>
    </Button>
    <TextBlock Text="{x:Bind ViewModel.ExternalTriggerStatus, Mode=OneWay}" />
  </StackPanel>
</UserControl>
