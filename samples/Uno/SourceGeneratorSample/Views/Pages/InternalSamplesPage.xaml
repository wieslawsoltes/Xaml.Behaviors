<UserControl x:Class="SourceGeneratorSample.Views.Pages.InternalSamplesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:vm="using:SourceGeneratorSample.ViewModels"
             xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
  <StackPanel Spacing="10">
    <TextBlock Text="Internal Action &amp; Trigger" FontWeight="Bold" />
    <Button Content="Submit (Internal Action)">
      <i:Interaction.Behaviors>
        <primitives:ButtonBaseClickTrigger>
          <vm:SubmitAction TargetObject="{x:Bind ViewModel}" />
        </primitives:ButtonBaseClickTrigger>
      </i:Interaction.Behaviors>
    </Button>
    <TextBlock Text="{x:Bind ViewModel.InternalSubmitMessage, Mode=OneWay}" />

    <Button Content="Reset (Internal Action)">
      <i:Interaction.Behaviors>
        <primitives:ButtonBaseClickTrigger>
          <vm:ResetAction TargetObject="{x:Bind ViewModel}" />
        </primitives:ButtonBaseClickTrigger>
      </i:Interaction.Behaviors>
    </Button>
  </StackPanel>
</UserControl>
