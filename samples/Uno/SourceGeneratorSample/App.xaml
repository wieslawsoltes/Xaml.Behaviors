<Application x:Class="SourceGeneratorSample.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:SourceGeneratorSample.Converters">
  <!-- The WinUI (Fluent) control templates, the twin of the Avalonia FluentTheme; the theme follows the system. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <!-- WinUI XAML has no x:Static: the shared converter is declared as a resource. -->
      <conv:BooleanNegationConverter x:Key="BooleanNegationConverter" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
