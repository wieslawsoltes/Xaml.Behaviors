<Application x:Class="BehaviorsTestApplication.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedTheme="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- The vertical sidebar look of MainView (Avalonia SideBar.axaml, TabControl.sidebar). -->
        <ResourceDictionary Source="ms-appx:///SideBar.xaml" />
        <!-- The custom tab styles of the Draggable sample (Avalonia Styles/DraggableCustomStyles.axaml). -->
        <ResourceDictionary Source="ms-appx:///Styles/DraggableCustomStyles.xaml" />
        <!-- The template of CustomControl (Avalonia Controls/CustomControl.axaml). -->
        <ResourceDictionary Source="ms-appx:///Controls/CustomControl.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- The sample brushes, with the keys of the Avalonia App.axaml. -->
      <SolidColorBrush x:Key="BlackBrush" Color="Black" />
      <SolidColorBrush x:Key="WhiteBrush" Color="White" />
      <SolidColorBrush x:Key="GrayBrush" Color="Gray" />
      <SolidColorBrush x:Key="RedBrush" Color="Red" />
      <SolidColorBrush x:Key="GreenBrush" Color="Green" />
      <SolidColorBrush x:Key="BlueBrush" Color="Blue" />
      <SolidColorBrush x:Key="YellowBrush" Color="Yellow" />
      <SolidColorBrush x:Key="PinkBrush" Color="Pink" />

      <!-- Avalonia App.axaml: buttons stretch and center their content. -->
      <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
