<Project Sdk="Uno.Sdk">

  <!-- Uno Platform sample for XAML Behaviors (Skia desktop head). -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <UnoPortAliases>false</UnoPortAliases>
    <ApplicationTitle>XAML Behaviors (Uno Platform)</ApplicationTitle>
    <ApplicationId>com.wieslawsoltes.xamlbehaviors.uno.sample</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <UnoFeatures>SkiaRenderer</UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ReactiveUI.Uno" VersionOverride="25.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The single assembly package (Xaml.Behaviors.Uno); the individual packages work the same way. -->
    <ProjectReference Include="..\..\..\src\Uno\Xaml.Behaviors\Xaml.Behaviors.csproj" />
  </ItemGroup>

</Project>
