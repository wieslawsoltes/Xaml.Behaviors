<UserControl x:Class="BehaviorsTestApplication.Views.Pages.InteractionTriggerBehaviorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             xmlns:behaviors="using:BehaviorsTestApplication.Behaviors">
  <StackPanel Margin="5" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBox x:Name="TargetTextBox" Text="Initial Text" />
    <Button Content="Trigger" Command="{x:Bind ViewModel.TriggerCommand}">
      <i:Interaction.Behaviors>
        <behaviors:UnitInteractionTriggerBehavior Interaction="{x:Bind ViewModel.TestInteraction}">
          <ic:ChangePropertyAction TargetObject="{x:Bind TargetTextBox}"
                                   PropertyName="Text"
                                   Value="Triggered" />
        </behaviors:UnitInteractionTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
  </StackPanel>
</UserControl>
