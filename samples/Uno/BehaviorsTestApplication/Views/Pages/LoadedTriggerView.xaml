<UserControl x:Class="BehaviorsTestApplication.Views.Pages.LoadedTriggerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             xmlns:icustom="using:Xaml.Interactions.Custom"
             mc:Ignorable="d"
             d:DesignWidth="300"
             d:DesignHeight="200">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock x:Name="StatusText" Text="Waiting for load" FontWeight="SemiBold" />
    <Border Padding="12" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="6">
      <i:Interaction.Behaviors>
        <icustom:LoadedTrigger>
          <ic:ChangePropertyAction TargetObject="{x:Bind StatusText}"
                                   PropertyName="Text"
                                   Value="Control Loaded" />
        </icustom:LoadedTrigger>
      </i:Interaction.Behaviors>
      <TextBlock Text="This content updates when LoadedTrigger fires." />
    </Border>
  </StackPanel>
</UserControl>
