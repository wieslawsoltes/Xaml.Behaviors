<UserControl x:Class="BehaviorsTestApplication.Views.Pages.PointerTriggersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             xmlns:icustom="using:Xaml.Interactions.Custom"
             xmlns:converters="using:Xaml.Interactions.Custom.Converters"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450">
  <!-- The view model (PointerTriggersViewModel) is set in the constructor; the pointer positions are written to the console. -->
  <Canvas Width="500" Height="500" Background="WhiteSmoke">
    <i:Interaction.Behaviors>
      <icustom:PointerPressedTrigger EventRoutingStrategy="Bubble">
        <icustom:CapturePointerAction />
        <!-- Avalonia: InputConverter="{PointerEventArgsConverter}" (a markup extension). -->
        <ic:InvokeCommandAction Command="{x:Bind ViewModel.PointerPressedCommand}"
                                InputConverter="{x:Bind converters:PointerEventArgsConverter.Instance}" />
      </icustom:PointerPressedTrigger>
      <icustom:PointerReleasedTrigger EventRoutingStrategy="Bubble">
        <icustom:ReleasePointerCaptureAction />
        <ic:InvokeCommandAction Command="{x:Bind ViewModel.PointerReleasedCommand}"
                                InputConverter="{x:Bind converters:PointerEventArgsConverter.Instance}" />
      </icustom:PointerReleasedTrigger>
      <icustom:PointerMovedTrigger EventRoutingStrategy="Bubble">
        <ic:InvokeCommandAction Command="{x:Bind ViewModel.PointerMovedCommand}"
                                InputConverter="{x:Bind converters:PointerEventArgsConverter.Instance}" />
      </icustom:PointerMovedTrigger>
    </i:Interaction.Behaviors>
  </Canvas>
</UserControl>
