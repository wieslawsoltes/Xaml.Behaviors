<UserControl x:Class="BehaviorsTestApplication.Views.Pages.DataTriggerBehaviorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Rectangle x:Name="DataTriggerRectangle"
               Grid.Row="0" Margin="5"
               Fill="{StaticResource BlueBrush}"
               Stroke="{StaticResource GrayBrush}"
               StrokeThickness="5">
      <i:Interaction.Behaviors>
        <ic:DataTriggerBehavior Binding="{x:Bind Slider.Value, Mode=OneWay}"
                                ComparisonCondition="GreaterThan"
                                Value="50">
          <ic:ChangePropertyAction TargetObject="{x:Bind DataTriggerRectangle}"
                                   PropertyName="Fill"
                                   Value="{StaticResource YellowBrush}" />
        </ic:DataTriggerBehavior>
        <ic:DataTriggerBehavior Binding="{x:Bind Slider.Value, Mode=OneWay}"
                                ComparisonCondition="LessThanOrEqual"
                                Value="50">
          <ic:ChangePropertyAction TargetObject="{x:Bind DataTriggerRectangle}"
                                   PropertyName="Fill"
                                   Value="{StaticResource BlueBrush}" />
        </ic:DataTriggerBehavior>
      </i:Interaction.Behaviors>
    </Rectangle>
    <StackPanel Grid.Row="1"
                Margin="5,0,5,5"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
      <TextBlock Text="{x:Bind Slider.Value, Mode=OneWay}"
                 VerticalAlignment="Center"
                 Width="50"
                 Foreground="{StaticResource GrayBrush}" />
      <!-- Avalonia IsSnapToTickEnabled/TickFrequency: WinUI SnapsTo="Ticks" with StepFrequency. -->
      <Slider x:Name="Slider" Width="400" SnapsTo="Ticks" TickFrequency="1" StepFrequency="1" />
    </StackPanel>
  </Grid>
</UserControl>
