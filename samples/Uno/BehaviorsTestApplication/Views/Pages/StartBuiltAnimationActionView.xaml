<UserControl x:Class="BehaviorsTestApplication.Views.Pages.StartBuiltAnimationActionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             xmlns:icustom="using:Xaml.Interactions.Custom"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="150">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
    <!--
      StartBuiltAnimationAction animates the sender of its trigger: the stream behavior runs it on the TextBlock
      (an EventTriggerBehavior on the button would animate the Text property of the Button).
      The view model is a CustomAnimatorViewModel (set in the constructor of the view).
    -->
    <TextBlock x:Name="AnimatedText" Text="" FontSize="24">
      <i:Interaction.Behaviors>
        <ic:ObservableStreamBehavior Source="{x:Bind ViewModel.AnimationRequests}">
          <ic:ObservableStreamBehavior.Actions>
            <icustom:StartBuiltAnimationAction AnimationBuilder="{x:Bind ViewModel.AnimationBuilder}" />
          </ic:ObservableStreamBehavior.Actions>
        </ic:ObservableStreamBehavior>
      </i:Interaction.Behaviors>
    </TextBlock>
    <Button x:Name="StartButton" Content="Start Animation" Command="{x:Bind ViewModel.StartAnimationCommand}" />
  </StackPanel>
</UserControl>
