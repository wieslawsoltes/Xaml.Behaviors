<UserControl x:Class="BehaviorsTestApplication.Views.Pages.DragAndDropView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:icustom="using:Xaml.Interactions.Custom"
             xmlns:idd="using:Xaml.Interactions.DragAndDrop"
             xmlns:idrag="using:Xaml.Interactions.Draggable"
             xmlns:vm="using:BehaviorsTestApplication.ViewModels"
             xmlns:behaviors="using:BehaviorsTestApplication.Behaviors"
             xmlns:controls="using:BehaviorsTestApplication.Controls"
             xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
             xmlns:toolkitPrimitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
  <!--
    WinUI twin of the Drag and Drop sample (the view model is the data context set by the shared code-behind). The
    Avalonia style classes (ItemsDragAndDrop, NodesDragAndDrop, Reorder, DragAndDrop) become keyed styles and
    Interaction.BehaviorsTemplate setters on the item containers (ItemContainerStyle). WinUI differences: there is no
    GridSplitter (fixed gaps), TreeView.SelectedItems is read only (not bound), the :dragging pseudo class style is not
    available and the managed (in-process) drag and drop is not part of the Uno port.
  -->
  <UserControl.Resources>
    <!-- IconGrabber, MIT License, author: Primer, taken from: https://www.svgrepo.com/svg/347759/grabber -->
    <x:String x:Key="IconGrabberData">M15 18a1 1 0 100-2 1 1 0 000 2zm1-6a1 1 0 11-2 0 1 1 0 012 0zm-7 6a1 1 0 100-2 1 1 0 000 2zm0-5a1 1 0 100-2 1 1 0 000 2zm7-6a1 1 0 11-2 0 1 1 0 012 0zM9 8a1 1 0 100-2 1 1 0 000 2z</x:String>

    <DataTemplate x:Key="ReorderPlaceholder">
      <Border BorderThickness="0,0,0,2" BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}" />
    </DataTemplate>

    <behaviors:ItemsListBoxDropHandler x:Key="ItemsDropHandler" />
    <behaviors:ItemsListBoxDropHandler x:Key="ItemsListBoxDropHandler" />
    <behaviors:NodesListBoxDropHandler x:Key="NodesListBoxDropHandler" />
    <behaviors:NodesTreeViewDropHandler x:Key="NodesTreeViewDropHandler" />
    <behaviors:ItemsDataGridDropHandler x:Key="ItemsDataGridDropHandler" />

    <!-- ListBox.ItemsDragAndDrop ListBoxItem -->
    <Style x:Key="ItemsDragAndDropItemStyle" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="i:Interaction.BehaviorsTemplate">
        <Setter.Value>
          <DataTemplate>
            <i:BehaviorCollectionHost>
              <idd:ContextDragBehavior HorizontalDragThreshold="3" VerticalDragThreshold="3" />
            </i:BehaviorCollectionHost>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ListBox.Reorder ListBoxItem -->
    <Style x:Key="ReorderItemStyle" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="i:Interaction.BehaviorsTemplate">
        <Setter.Value>
          <DataTemplate>
            <i:BehaviorCollectionHost>
              <idrag:ListReorderDragBehavior PlaceholderTemplate="{StaticResource ReorderPlaceholder}" Orientation="Vertical" />
            </i:BehaviorCollectionHost>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ListBox.NodesDragAndDrop ListBoxItem -->
    <Style x:Key="NodesDragAndDropItemStyle" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="i:Interaction.BehaviorsTemplate">
        <Setter.Value>
          <DataTemplate>
            <i:BehaviorCollectionHost>
              <idd:ContextDragBehavior />
            </i:BehaviorCollectionHost>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- TreeView.NodesDragAndDrop TreeViewItem -->
    <Style x:Key="NodesDragAndDropTreeViewItemStyle" TargetType="TreeViewItem">
      <Setter Property="IsExpanded" Value="True" />
      <Setter Property="i:Interaction.BehaviorsTemplate">
        <Setter.Value>
          <DataTemplate>
            <i:BehaviorCollectionHost>
              <idd:ContextDragBehavior HorizontalDragThreshold="3" VerticalDragThreshold="3" />
            </i:BehaviorCollectionHost>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      DataGrid.DragAndDrop DataGridRowHeader: only the row header starts a drag, which prevents a conflict between text
      selection in a cell and drag and drop.
    -->
    <Style x:Key="DragAndDropRowHeaderStyle" TargetType="toolkitPrimitives:DataGridRowHeader">
      <Setter Property="i:Interaction.BehaviorsTemplate">
        <Setter.Value>
          <DataTemplate>
            <i:BehaviorCollectionHost>
              <idd:ContextDragBehavior HorizontalDragThreshold="3" VerticalDragThreshold="3" />
            </i:BehaviorCollectionHost>
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <!-- Avalonia sets the Content from a Template (one image per header): WinUI uses the ContentTemplate. -->
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <!-- Use your own image here, I used this: https://www.svgrepo.com/svg/347759/grabber -->
            <PathIcon Margin="12,0,12,0"
                      Width="12"
                      Height="12"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Foreground="Black"
                      Data="{StaticResource IconGrabberData}" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <TabView IsAddTabButtonVisible="False" VerticalAlignment="Stretch">

    <TabViewItem Header="TreeView" IsClosable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- Avalonia binds SelectedItems TwoWay; the WinUI TreeView.SelectedItems is read only. -->
        <TreeView ItemsSource="{x:Bind ViewModel.Nodes}"
                  Grid.Column="0">
          <i:Interaction.Behaviors>
            <idd:ContextDropBehavior Handler="{StaticResource NodesTreeViewDropHandler}" />
          </i:Interaction.Behaviors>
          <TreeView.ItemTemplate>
            <DataTemplate x:DataType="vm:DragNodeViewModel">
              <TreeViewItem ItemsSource="{x:Bind Nodes}" Style="{StaticResource NodesDragAndDropTreeViewItemStyle}">
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
              </TreeViewItem>
            </DataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
        <!-- Avalonia GridSplitter: WinUI has no GridSplitter (a fixed gap). -->
        <ListView ItemsSource="{x:Bind ViewModel.Nodes}"
                  ItemContainerStyle="{StaticResource NodesDragAndDropItemStyle}"
                  Grid.Column="2">
          <i:Interaction.Behaviors>
            <idd:ContextDropBehavior Handler="{StaticResource NodesListBoxDropHandler}" />
          </i:Interaction.Behaviors>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:DragNodeViewModel">
              <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </TabViewItem>

    <TabViewItem Header="ListBox" IsClosable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <ListView ItemsSource="{x:Bind ViewModel.Items}"
                ItemContainerStyle="{StaticResource ItemsDragAndDropItemStyle}">
        <i:Interaction.Behaviors>
          <idd:ContextDropBehavior Handler="{StaticResource ItemsListBoxDropHandler}" />
        </i:Interaction.Behaviors>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="vm:DragItemViewModel">
            <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </TabViewItem>

    <TabViewItem Header="Managed (Preview)" IsClosable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <!--
        Not available: ManagedContextDragBehavior/ManagedContextDropBehavior (ManagedDragDrop/**) are not part of the Uno
        port (src/Uno/Xaml.Behaviors.Interactions.DragAndDrop/SharedSources.props).
      -->
      <controls:NotAvailableOnUnoView Title="Managed (Preview)"
                                      Reason="The managed (in-process) drag and drop builds its own DragEventArgs and a topmost preview window; WinUI DragEventArgs have no public constructor and Uno Platform has no top-level preview windows. The WinUI drag and drop of the other tabs is already in-process on Uno Platform and shows a drag visual." />
    </TabViewItem>

    <TabViewItem Header="Reorder Behavior" IsClosable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <ListView ItemsSource="{x:Bind ViewModel.Items}"
                ItemContainerStyle="{StaticResource ReorderItemStyle}">
        <ListView.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Vertical" />
          </ItemsPanelTemplate>
        </ListView.ItemsPanel>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="vm:DragItemViewModel">
            <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </TabViewItem>

    <TabViewItem Header="ItemDragBehavior" IsClosable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <StackPanel Spacing="12" Margin="12">
        <TextBlock Text="ItemDragBehavior reorders list items by dragging them directly within the control."
                   TextWrapping="Wrap" />
        <ListView ItemsSource="{x:Bind ViewModel.Items}"
                  MinHeight="220">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="i:Interaction.BehaviorsTemplate">
                <Setter.Value>
                  <DataTemplate>
                    <i:BehaviorCollectionHost>
                      <idrag:ItemDragBehavior Orientation="Vertical" />
                    </i:BehaviorCollectionHost>
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:DragItemViewModel">
              <Border Padding="8"
                      Margin="2"
                      Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                      CornerRadius="4">
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
              </Border>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock Text="Drag items up or down to change their order; release to commit the move."
                   FontSize="12"
                   TextWrapping="Wrap" />
      </StackPanel>
    </TabViewItem>

    <TabViewItem Header="ItemNudgeDropBehavior" IsClosable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <StackPanel Spacing="12" Margin="12">
        <TextBlock Text="ItemNudgeDropBehavior nudges neighbouring items out of the way during a drag-over to preview the drop location."
                   TextWrapping="Wrap" />
        <ListView ItemsSource="{x:Bind ViewModel.Items}"
                  AllowDrop="True"
                  MinHeight="220">
          <i:Interaction.Behaviors>
            <idd:ContextDropBehavior Handler="{StaticResource ItemsDropHandler}" />
            <icustom:ItemNudgeDropBehavior Orientation="Vertical" />
          </i:Interaction.Behaviors>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:DragItemViewModel">
              <Border Padding="8"
                      Margin="2"
                      Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                      CornerRadius="4">
                <i:Interaction.Behaviors>
                  <idd:ContextDragBehavior />
                </i:Interaction.Behaviors>
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
              </Border>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock Text="Start a drag on any item and hover between neighbours to see them slide aside before dropping."
                   FontSize="12"
                   TextWrapping="Wrap" />
      </StackPanel>
    </TabViewItem>

    <TabViewItem Header="DataGrid" IsClosable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <Grid>
        <!-- The Windows Community Toolkit DataGrid (Uno Platform port). -->
        <toolkit:DataGrid
          AutoGenerateColumns="False"
          ItemsSource="{x:Bind ViewModel.Items}"
          CanUserResizeColumns="True"
          HeadersVisibility="All"
          RowHeaderWidth="24"
          RowHeaderStyle="{StaticResource DragAndDropRowHeaderStyle}">
          <i:Interaction.Behaviors>
            <idd:ContextDropBehavior Handler="{StaticResource ItemsDataGridDropHandler}" />
          </i:Interaction.Behaviors>
          <toolkit:DataGrid.Columns>
            <!--
              Avalonia: a TextBlock header. The Uno Platform toolkit DataGrid fails to load with an element header, so the
              header is the text.
            -->
            <toolkit:DataGridTextColumn
              Width="*"
              Binding="{Binding Title}"
              Header="Title" />
          </toolkit:DataGrid.Columns>
        </toolkit:DataGrid>
      </Grid>
    </TabViewItem>

  </TabView>

</UserControl>
