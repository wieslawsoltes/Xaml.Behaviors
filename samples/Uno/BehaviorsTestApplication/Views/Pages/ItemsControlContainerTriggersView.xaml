<UserControl x:Class="BehaviorsTestApplication.Views.Pages.ItemsControlContainerTriggersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             xmlns:icustom="using:Xaml.Interactions.Custom"
             xmlns:vm="using:BehaviorsTestApplication.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="700"
             d:DesignHeight="400">
  <Grid ColumnSpacing="16" Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="2*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Grid.ColumnSpan="3"
               Text="ItemsControl container triggers surface lifecycle events for item containers. Scroll the list and change selection to see events populate the log."
               TextWrapping="Wrap" />

    <!--
      Avalonia: a ListBox with SelectedItem="{Binding SelectedItem, Mode=TwoWay}". On WinUI the container triggers
      attach to an ItemsRepeater (ElementPrepared, ElementClearing, ElementIndexChanged), which has no selection:
      "Remove selected" removes the view model's SelectedItem (the last added item). ItemsControlPreparingContainerTrigger
      is not available (WinUI items hosts raise no event before a container is prepared).
    -->
    <ScrollViewer Grid.Row="1"
                  Grid.Column="0"
                  Height="260">
      <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
        <i:Interaction.Behaviors>
          <icustom:ItemsControlContainerPreparedTrigger>
            <ic:CallMethodAction MethodName="OnContainerPrepared" TargetObject="{x:Bind ViewModel}" />
          </icustom:ItemsControlContainerPreparedTrigger>
          <icustom:ItemsControlContainerClearingTrigger>
            <ic:CallMethodAction MethodName="OnContainerClearing" TargetObject="{x:Bind ViewModel}" />
          </icustom:ItemsControlContainerClearingTrigger>
          <icustom:ItemsControlContainerIndexChangedTrigger>
            <ic:CallMethodAction MethodName="OnContainerIndexChanged" TargetObject="{x:Bind ViewModel}" />
          </icustom:ItemsControlContainerIndexChangedTrigger>
        </i:Interaction.Behaviors>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="vm:ItemViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,6">
              <TextBlock Text="{x:Bind Value, Mode=OneWay}" />
              <!-- Same literal text as the Avalonia sample (the attribute does not start with a markup extension). -->
              <TextBlock Text="(Color: {Binding Color})" FontSize="11" />
            </StackPanel>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8" VerticalAlignment="Center">
      <Button Content="Add item">
        <i:Interaction.Behaviors>
          <ic:EventTriggerBehavior EventName="Click">
            <ic:CallMethodAction MethodName="AddSampleItem" TargetObject="{x:Bind ViewModel}" />
          </ic:EventTriggerBehavior>
        </i:Interaction.Behaviors>
      </Button>
      <Button Content="Remove selected">
        <i:Interaction.Behaviors>
          <ic:EventTriggerBehavior EventName="Click">
            <ic:CallMethodAction MethodName="RemoveSelectedItem" TargetObject="{x:Bind ViewModel}" />
          </ic:EventTriggerBehavior>
        </i:Interaction.Behaviors>
      </Button>
    </StackPanel>

    <Border Grid.Row="1"
            Grid.Column="2"
            BorderThickness="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            CornerRadius="6">
      <StackPanel Margin="8" Spacing="8">
        <TextBlock Text="Event log" FontWeight="SemiBold" />
        <ListView ItemsSource="{x:Bind ViewModel.ContainerEventLog}" Height="220" />
        <Button Content="Clear log">
          <i:Interaction.Behaviors>
            <ic:EventTriggerBehavior EventName="Click">
              <ic:CallMethodAction MethodName="ClearContainerLog" TargetObject="{x:Bind ViewModel}" />
            </ic:EventTriggerBehavior>
          </i:Interaction.Behaviors>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
