             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:BehaviorsTestApplication.Controls">
  <controls:NotAvailableOnUnoView Title="Notifications"
                                  Reason="NotificationManagerBehavior and the Show*NotificationAction actions host Avalonia notification managers (WindowNotificationManager, NotificationCard), which have no WinUI counterpart." />
