<UserControl x:Class="BehaviorsTestApplication.Views.Pages.TaskCompletedTriggerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             xmlns:icustom="using:Xaml.Interactions.Custom"
             mc:Ignorable="d"
             d:DesignWidth="500"
             d:DesignHeight="260">

  <StackPanel Spacing="12" Margin="16">
    <TextBlock Text="TaskCompletedTrigger monitors a Task and runs actions when it finishes." TextWrapping="Wrap" />
    <TextBlock Text="{x:Bind ViewModel.TaskStatusMessage, Mode=OneWay}" FontWeight="SemiBold" />
    <Button Width="140" Content="Start task" Command="{x:Bind ViewModel.StartSampleTaskCommand}">
      <i:Interaction.Behaviors>
        <ic:TaskCompletedTrigger Task="{x:Bind ViewModel.SampleTask, Mode=OneWay}">
          <icustom:SetViewModelPropertyAction PropertyName="TaskCompletedIndicator" Value="True" />
          <icustom:SetViewModelPropertyAction PropertyName="TaskStatusMessage" Value="Task finished via trigger." />
        </ic:TaskCompletedTrigger>
      </i:Interaction.Behaviors>
    </Button>
    <CheckBox Content="Completed" IsChecked="{x:Bind ViewModel.TaskCompletedIndicator, Mode=OneWay}" IsEnabled="False" />
  </StackPanel>
</UserControl>
