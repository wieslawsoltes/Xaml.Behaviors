<UserControl x:Class="BehaviorsTestApplication.Views.Pages.AspectRatioBehaviorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ir="using:Xaml.Interactions.Responsive"
             xmlns:behaviors="using:BehaviorsTestApplication.Behaviors"
             xmlns:converters="using:BehaviorsTestApplication.Converters"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <!--
    WinUI has no style classes: on Uno Platform the classes set by AspectRatioBehavior move the element to the visual
    state of the same name. The responsive StackPanel (Avalonia StackPanel.responsive/.horizontal/.vertical styles) is
    the content of the ResponsiveHost UserControl and carries the visual states. The behavior observes the page root
    instead of the Avalonia TopLevel (WinUI windows are not elements).
  -->
  <Grid x:Name="AspectRoot" Background="{StaticResource GrayBrush}" Margin="5">
    <i:Interaction.Behaviors>
      <behaviors:ElementBoundsBehavior x:Name="RootBounds" />
    </i:Interaction.Behaviors>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5" Margin="5">
      <TextBlock Text="Width: " />
      <TextBlock Text="{x:Bind converters:SampleFormat.Number(RootBounds.Bounds.Width), Mode=OneWay}" />
      <TextBlock Text=" Height: " />
      <TextBlock Text="{x:Bind converters:SampleFormat.Number(RootBounds.Bounds.Height), Mode=OneWay}" />
      <!-- Avalonia also lists the style classes (ClassesToStringConverter); WinUI exposes no observable visual state. -->
    </StackPanel>
    <UserControl x:Name="ResponsiveHost" Grid.Row="0">
      <StackPanel x:Name="ResponsiveStackPanel" Margin="5">
        <i:Interaction.Behaviors>
          <ir:AspectRatioBehavior SourceControl="{x:Bind AspectRoot}">
            <ir:AspectRatioClassSetter MinRatio="0" MaxRatio="1" ClassName="vertical" />
            <ir:AspectRatioClassSetter MinRatio="1" MaxRatio="Infinity" ClassName="horizontal" />
          </ir:AspectRatioBehavior>
        </i:Interaction.Behaviors>
        <VisualStateManager.VisualStateGroups>
          <VisualStateGroup x:Name="AspectRatioStates">
            <VisualState x:Name="Normal" />
            <VisualState x:Name="horizontal">
              <VisualState.Setters>
                <Setter Target="ResponsiveStackPanel.Orientation" Value="Horizontal" />
              </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="vertical">
              <VisualState.Setters>
                <Setter Target="ResponsiveStackPanel.Orientation" Value="Vertical" />
              </VisualState.Setters>
            </VisualState>
          </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock Text="Item1" />
        <TextBlock Text="Item2" />
        <TextBlock Text="Item3" />
        <TextBlock Text="Item4" />
      </StackPanel>
    </UserControl>
  </Grid>
</UserControl>
