<UserControl x:Class="BehaviorsTestApplication.Views.Pages.InsertItemToItemsControlActionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             xmlns:icustom="using:Xaml.Interactions.Custom"
             xmlns:vm="using:BehaviorsTestApplication.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <StackPanel Spacing="10" Margin="5">
    <Button Content="Insert Item At 0">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Click">
          <icustom:InsertItemToItemsControlAction ItemsControl="{x:Bind ItemsControl}" Index="0">
            <!--
              Avalonia: <ObjectTemplate> with x:Arguments creates a new ItemViewModel on each click. WinUI has no
              ObjectTemplate (DataTemplate only creates UI elements) and no x:Arguments: the action inserts this
              ItemViewModel instance on each click.
            -->
            <vm:ItemViewModel Value="Added Item" Color="Black" />
          </icustom:InsertItemToItemsControlAction>
        </ic:EventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
    <ItemsControl x:Name="ItemsControl" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ItemViewModel">
          <!-- Avalonia: DockPanel (WinUI has none). -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Value:"
                       Margin="5"
                       VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{x:Bind Value, Mode=TwoWay}" Margin="5" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
