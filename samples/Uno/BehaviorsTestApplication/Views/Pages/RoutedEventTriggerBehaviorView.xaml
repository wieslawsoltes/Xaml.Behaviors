<UserControl x:Class="BehaviorsTestApplication.Views.Pages.RoutedEventTriggerBehaviorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:xaml="using:Microsoft.UI.Xaml"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             xmlns:icustom="using:Xaml.Interactions.Custom"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBox x:Name="TextBox" Text="Hello" Grid.Row="0" Margin="5" />
    <Button x:Name="ChangeProperty" Content="Change Property" Grid.Row="1" Margin="5,0,5,5">
      <i:Interaction.Behaviors>
        <!--
          Avalonia: RoutedEvent="{x:Static Button.ClickEvent}". WinUI Button.Click is a CLR event, not a routed event:
          the button's routed Tapped event is used instead (WinUI routed events always bubble).
        -->
        <icustom:RoutedEventTriggerBehavior RoutedEvent="{x:Bind xaml:UIElement.TappedEvent}"
                                            RoutingStrategies="Bubble"
                                            SourceInteractive="{x:Bind ChangeProperty}">
          <ic:ChangePropertyAction TargetObject="{x:Bind TextBox}" PropertyName="Text" Value="World" />
        </icustom:RoutedEventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
    <Rectangle x:Name="Rectangle"
               Grid.Row="2" Margin="5"
               Fill="{StaticResource BlueBrush}"
               Stroke="{StaticResource GrayBrush}"
               StrokeThickness="5">
      <i:Interaction.Behaviors>
        <!-- Avalonia: {x:Static InputElement.PointerPressedEvent} / PointerReleasedEvent. -->
        <icustom:RoutedEventTriggerBehavior RoutedEvent="{x:Bind xaml:UIElement.PointerPressedEvent}"
                                            RoutingStrategies="Tunnel">
          <ic:ChangePropertyAction TargetObject="{x:Bind Rectangle}"
                                   PropertyName="Fill"
                                   Value="{StaticResource YellowBrush}" />
        </icustom:RoutedEventTriggerBehavior>
        <icustom:RoutedEventTriggerBehavior RoutedEvent="{x:Bind xaml:UIElement.PointerReleasedEvent}"
                                            RoutingStrategies="Tunnel">
          <ic:ChangePropertyAction TargetObject="{x:Bind Rectangle}"
                                   PropertyName="Fill"
                                   Value="{StaticResource BlueBrush}" />
        </icustom:RoutedEventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Rectangle>
  </Grid>
</UserControl>
