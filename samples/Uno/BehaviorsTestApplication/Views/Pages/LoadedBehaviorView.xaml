<UserControl x:Class="BehaviorsTestApplication.Views.Pages.LoadedBehaviorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:behaviors="using:BehaviorsTestApplication.Behaviors"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="120">
  <StackPanel Spacing="5">
    <Button x:Name="Target" Content="Load">
      <i:Interaction.Behaviors>
        <behaviors:LoadedMessageBehavior Target="{x:Bind MessageText}" />
      </i:Interaction.Behaviors>
    </Button>
    <TextBlock x:Name="MessageText" />
  </StackPanel>
</UserControl>
