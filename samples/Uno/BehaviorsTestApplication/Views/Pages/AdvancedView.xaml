<UserControl x:Class="BehaviorsTestApplication.Views.Pages.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border x:Name="Button"
            Background="{StaticResource GreenBrush}"
            Width="100" Height="50"
            Grid.Row="1" Grid.Column="0"
            Margin="5,0,0,5">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="PointerPressed"
                                 SourceObject="{x:Bind Button}">
          <ic:ChangePropertyAction TargetObject="{x:Bind Button}"
                                   PropertyName="Background"
                                   Value="{StaticResource RedBrush}" />
          <ic:ChangePropertyAction TargetObject="{x:Bind Text}"
                                   PropertyName="Foreground"
                                   Value="{StaticResource YellowBrush}" />
          <ic:CallMethodAction TargetObject="{x:Bind ViewModel}"
                               MethodName="IncrementCount" />
        </ic:EventTriggerBehavior>
        <ic:EventTriggerBehavior EventName="PointerReleased"
                                 SourceObject="{x:Bind Button}">
          <ic:ChangePropertyAction TargetObject="{x:Bind Button}"
                                   PropertyName="Background"
                                   Value="{StaticResource GreenBrush}" />
          <ic:ChangePropertyAction TargetObject="{x:Bind Text}"
                                   PropertyName="Foreground"
                                   Value="{StaticResource WhiteBrush}" />
          <ic:CallMethodAction TargetObject="{x:Bind ViewModel}"
                               MethodName="DecrementCount" />
        </ic:EventTriggerBehavior>
      </i:Interaction.Behaviors>
      <TextBlock x:Name="Text"
                 Text="{x:Bind ViewModel.Count, Mode=OneWay}"
                 Foreground="{StaticResource WhiteBrush}"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center" />
    </Border>
  </Grid>
</UserControl>
