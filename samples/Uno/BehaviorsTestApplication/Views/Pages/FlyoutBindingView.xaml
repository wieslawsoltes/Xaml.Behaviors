<UserControl x:Class="BehaviorsTestApplication.Views.Pages.FlyoutBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <StackPanel>
    <Button x:Name="FlyoutButton" Content="Press me">
      <Button.Flyout>
        <Flyout>
          <!-- x:Bind is compiled into the view, so the flyout content (outside the visual tree) binds to the view model. -->
          <TextBox PlaceholderText="Type here" MinWidth="200">
            <i:Interaction.Behaviors>
              <ic:EventTriggerBehavior EventName="TextChanged">
                <ic:InvokeCommandAction Command="{x:Bind ViewModel.TextChangedCommand}" PassEventArgsToCommand="True"/>
              </ic:EventTriggerBehavior>
            </i:Interaction.Behaviors>
          </TextBox>
        </Flyout>
      </Button.Flyout>
    </Button>
    <TextBlock x:Name="GreetingTextBlock"
               Text="{x:Bind ViewModel.Greeting, Mode=OneWay}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
  </StackPanel>
</UserControl>
