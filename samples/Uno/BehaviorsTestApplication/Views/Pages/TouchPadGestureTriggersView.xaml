<!--
  Not available: the touch pad gesture triggers (PointerTouchPadGestureMagnify/Rotate/SwipeGestureTrigger) handle
  Avalonia gesture recognizer events that have no WinUI routed event; they are not part of the Uno port.
-->
<UserControl x:Class="BehaviorsTestApplication.Views.Pages.TouchPadGestureTriggersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:BehaviorsTestApplication.Controls">
  <controls:NotAvailableOnUnoView Title="TouchPad Gesture Triggers"
                                  Reason="The touch pad magnify, rotate and swipe gesture triggers handle Avalonia gesture events (PointerTouchPadGestureMagnify/Rotate/Swipe) that have no WinUI routed event." />
</UserControl>
