<UserControl x:Class="BehaviorsTestApplication.Views.Pages.EditableDragTreeViewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:idd="using:Xaml.Interactions.DragAndDrop"
             xmlns:vm="using:BehaviorsTestApplication.ViewModels"
             xmlns:controls="using:BehaviorsTestApplication.Controls"
             xmlns:behaviors="using:BehaviorsTestApplication.Behaviors"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <UserControl.Resources>
    <behaviors:NodesTreeViewDropHandler x:Key="NodesTreeViewDropHandler" />
  </UserControl.Resources>
  <!--
    Avalonia TreeView.NodesEditableDrag style: the TreeView gets the ContextDropBehavior, every TreeViewItem (the root
    of the WinUI item template, see EditableTreeViewView) gets a ContextDragBehavior and is expanded. The built-in
    TreeView item drag is disabled so the behaviors handle drag and drop.
  -->
  <TreeView ItemsSource="{x:Bind ViewModel.Nodes, Mode=OneWay}"
            CanDragItems="False"
            CanReorderItems="False">
    <i:Interaction.Behaviors>
      <idd:ContextDropBehavior Handler="{StaticResource NodesTreeViewDropHandler}" />
    </i:Interaction.Behaviors>
    <TreeView.ItemTemplate>
      <DataTemplate x:DataType="vm:DragNodeViewModel">
        <TreeViewItem ItemsSource="{x:Bind Nodes, Mode=OneWay}"
                      IsExpanded="True"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Margin="0"
                      Padding="0">
          <i:Interaction.Behaviors>
            <idd:ContextDragBehavior HorizontalDragThreshold="3" VerticalDragThreshold="3" />
          </i:Interaction.Behaviors>
          <controls:EditableItem Text="{x:Bind Title, Mode=TwoWay}" />
        </TreeViewItem>
      </DataTemplate>
    </TreeView.ItemTemplate>
  </TreeView>
</UserControl>
