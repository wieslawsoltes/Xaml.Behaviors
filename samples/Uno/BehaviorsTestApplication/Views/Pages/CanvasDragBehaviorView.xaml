<UserControl x:Class="BehaviorsTestApplication.Views.Pages.CanvasDragBehaviorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:idrag="using:Xaml.Interactions.Draggable"
             mc:Ignorable="d"
             d:DesignWidth="600"
             d:DesignHeight="450">
  <!--
    Avalonia theme resources: ThemeBorderBrush → CardStrokeColorDefaultBrush, ThemeBackgroundBrush →
    CardBackgroundFillColorDefaultBrush, SystemAccentColor → AccentFillColorDefaultBrush, ThemeControlHighBrush →
    SystemControlBackgroundBaseLowBrush.
  -->
  <StackPanel Spacing="12" Margin="16">
    <TextBlock Text="CanvasDragBehavior lets you reposition controls by dragging them within a Canvas. Each card remembers its new coordinates."
               TextWrapping="Wrap" />
    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Padding="12">
      <!-- Avalonia ClipToBounds="True": a clip of the canvas size. -->
      <Canvas Width="400" Height="260">
        <Canvas.Clip>
          <RectangleGeometry Rect="0,0,400,260" />
        </Canvas.Clip>
        <Border Canvas.Left="40"
                Canvas.Top="40"
                Width="120"
                Height="80"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="6">
          <i:Interaction.Behaviors>
            <idrag:CanvasDragBehavior />
          </i:Interaction.Behaviors>
          <TextBlock Text="Drag me" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
        </Border>
        <Border Canvas.Left="220"
                Canvas.Top="120"
                Width="120"
                Height="80"
                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                CornerRadius="6">
          <i:Interaction.Behaviors>
            <idrag:CanvasDragBehavior />
          </i:Interaction.Behaviors>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
            <TextBlock Text="Drag me too" TextAlignment="Center" />
            <TextBlock Text="Hold and move to explore" FontSize="11" TextAlignment="Center" />
          </StackPanel>
        </Border>
      </Canvas>
    </Border>
    <TextBlock Text="Tip: the behavior attaches to each draggable element, so you can mix movable cards with static decorations within the same canvas."
               FontSize="12"
               TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
