<UserControl x:Class="BehaviorsTestApplication.Views.Pages.GetClipboardFormatsActionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <Grid>
    <Button x:Name="GetFormatsButton" Content="Get Clipboard Formats" Margin="5">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Click" SourceObject="{x:Bind GetFormatsButton}">
          <ic:GetClipboardFormatsAction Command="{x:Bind ViewModel.GetClipboardFormatsCommand}" />
        </ic:EventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
  </Grid>
</UserControl>
