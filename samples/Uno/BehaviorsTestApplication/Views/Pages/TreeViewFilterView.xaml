<UserControl x:Class="BehaviorsTestApplication.Views.Pages.TreeViewFilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:icustom="using:Xaml.Interactions.Custom"
             xmlns:vm="using:BehaviorsTestApplication.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <!-- Avalonia: DockPanel (the search box and the message docked at the top); WinUI has no DockPanel. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBox x:Name="SearchBox"
             Grid.Row="0"
             PlaceholderText="Search..."
             Margin="0,0,0,8">
      <i:Interaction.Behaviors>
        <icustom:TreeViewFilterTextChangedTrigger SearchBox="{x:Bind SearchBox}">
          <icustom:ApplyTreeViewFilterAction TreeView="{x:Bind Tree}"
                                             Query="{x:Bind SearchBox.Text, Mode=OneWay}" />
        </icustom:TreeViewFilterTextChangedTrigger>
      </i:Interaction.Behaviors>
    </TextBox>
    <TextBlock x:Name="NoMatchesText"
               Grid.Row="1"
               Text="No items match the search."
               Margin="0,0,0,8"
               Visibility="Collapsed" />
    <!-- Avalonia: TreeDataTemplate (WinUI: the item template is a TreeViewItem with the children as ItemsSource). -->
    <TreeView x:Name="Tree" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
      <i:Interaction.Behaviors>
        <icustom:TreeViewFilterBehavior SearchBox="{x:Bind SearchBox}" NoMatchesControl="{x:Bind NoMatchesText}" />
      </i:Interaction.Behaviors>
      <TreeView.ItemTemplate>
        <DataTemplate x:DataType="vm:ItemViewModel">
          <TreeViewItem ItemsSource="{x:Bind Items, Mode=OneWay}" Content="{x:Bind Value, Mode=OneWay}" />
        </DataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </Grid>
</UserControl>
