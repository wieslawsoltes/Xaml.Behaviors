<UserControl x:Class="BehaviorsTestApplication.Views.Pages.ToolTipHelpersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             xmlns:icustom="using:Xaml.Interactions.Custom"
             xmlns:converters="using:BehaviorsTestApplication.Converters"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBox x:Name="TipBox" Margin="5" PlaceholderText="Enter tooltip text" />
    <Button Grid.Row="1" Margin="5" Content="Set Tooltip">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Click">
          <icustom:SetToolTipTipAction TargetControl="{x:Bind Target}" Tip="{x:Bind TipBox.Text, Mode=OneWay}" />
        </ic:EventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
    <!-- Avalonia: ToolTip.Tip (WinUI: ToolTipService.ToolTip). -->
    <Border x:Name="Target"
            Grid.Row="2"
            Margin="5"
            Padding="20"
            Background="{StaticResource BlueBrush}"
            ToolTipService.ToolTip="Initial tooltip">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="PointerEntered">
          <icustom:ShowToolTipAction />
        </ic:EventTriggerBehavior>
        <ic:EventTriggerBehavior EventName="PointerExited">
          <icustom:HideToolTipAction />
        </ic:EventTriggerBehavior>
        <icustom:ToolTipOpeningTrigger>
          <ic:CallMethodAction TargetObject="{x:Bind ViewModel}" MethodName="IncrementCount" />
        </icustom:ToolTipOpeningTrigger>
        <icustom:ToolTipClosingTrigger>
          <ic:CallMethodAction TargetObject="{x:Bind ViewModel}" MethodName="DecrementCount" />
        </icustom:ToolTipClosingTrigger>
      </i:Interaction.Behaviors>
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Hover to see tooltip" />
    </Border>
    <!-- Avalonia: StringFormat={}Count: {0} (WinUI bindings have no StringFormat; x:Bind calls a formatter). -->
    <TextBlock Grid.Row="3" Margin="5" HorizontalAlignment="Center" Text="{x:Bind converters:SampleFormat.Count(ViewModel.Count), Mode=OneWay}" />
  </Grid>
</UserControl>
