<UserControl x:Class="BehaviorsTestApplication.Views.Pages.ScrollBehaviorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:icustom="using:Xaml.Interactions.Custom"
             xmlns:converters="using:BehaviorsTestApplication.Converters"
             mc:Ignorable="d"
             d:DesignWidth="700"
             d:DesignHeight="500">
  <UserControl.Resources>
    <!-- NumberBox values are doubles; the view model index is an int (Avalonia NumericUpDown binds it directly). -->
    <converters:Int32ToDoubleConverter x:Key="Int32ToDoubleConverter" />
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Spacing="16" Margin="16">
      <TextBlock Text="ScrollToItemBehavior and ScrollToItemIndexBehavior subscribe to observables and automatically bring targets into view. Use the controls below to publish new requests."
                 TextWrapping="Wrap" />

      <Border Padding="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6">
        <Grid RowSpacing="8" ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="3*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.Resources>
            <!-- Avalonia Grid.Styles: Style Selector="Button". -->
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
              <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
          </Grid.Resources>

          <TextBlock Text="All items" FontWeight="SemiBold" Grid.Row="0" Grid.Column="0" />
          <TextBlock Text="Scroll to item" FontWeight="SemiBold" Grid.Row="0" Grid.Column="2" />

          <!-- Avalonia ListBox: a WinUI ListView. -->
          <ListView Grid.Row="1"
                    Grid.Column="0"
                    Grid.RowSpan="2"
                    Width="220"
                    Height="260"
                    ItemsSource="{x:Bind ViewModel.ScrollDemoItems, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.ScrollSelectedItem, Mode=TwoWay}">
            <i:Interaction.Behaviors>
              <icustom:ScrollToItemBehavior Item="{x:Bind ViewModel.ScrollToItemObservable}" />
              <icustom:ScrollToItemIndexBehavior ItemIndex="{x:Bind ViewModel.ScrollToIndexObservable}" />
            </i:Interaction.Behaviors>
          </ListView>

          <StackPanel Grid.Row="1" Grid.Column="2" Spacing="8">
            <ComboBox Width="220"
                      ItemsSource="{x:Bind ViewModel.ScrollDemoItems, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.ScrollSelectedItem, Mode=TwoWay}" />
            <Button Content="Scroll selected item"
                    Command="{x:Bind ViewModel.ScrollToItemCommand}"
                    CommandParameter="{x:Bind ViewModel.ScrollSelectedItem, Mode=OneWay}" />
          </StackPanel>

          <StackPanel Grid.Row="2" Grid.Column="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Index" VerticalAlignment="Center" />
              <!-- Avalonia NumericUpDown: a WinUI NumberBox with spin buttons. -->
              <NumberBox Width="120"
                         SpinButtonPlacementMode="Inline"
                         SmallChange="1"
                         Minimum="0"
                         Maximum="{x:Bind ViewModel.MaxScrollIndex, Mode=OneWay, Converter={StaticResource Int32ToDoubleConverter}}"
                         Value="{x:Bind ViewModel.ScrollTargetIndex, Mode=TwoWay, Converter={StaticResource Int32ToDoubleConverter}}" />
            </StackPanel>
            <Button Content="Scroll to index"
                    Command="{x:Bind ViewModel.ScrollToIndexCommand}"
                    CommandParameter="{x:Bind ViewModel.ScrollTargetIndex, Mode=OneWay}" />
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel Spacing="8">
        <TextBlock Text="HorizontalScrollViewerBehavior" FontWeight="SemiBold" />
        <TextBlock Text="Scroll with the mouse wheel to move the cards sideways. Use the checkbox to require holding Shift." FontSize="12" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <CheckBox Content="Require Shift"
                    IsChecked="{x:Bind ViewModel.RequireShiftForHorizontalScroll, Mode=TwoWay}" />
          <ComboBox Width="140"
                    ItemsSource="{x:Bind ViewModel.ScrollChangeSizeOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedScrollChangeSize, Mode=TwoWay}" />
        </StackPanel>
        <Border Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
            <i:Interaction.Behaviors>
              <icustom:HorizontalScrollViewerBehavior RequireShiftKey="{x:Bind ViewModel.RequireShiftForHorizontalScroll, Mode=OneWay}"
                                                      ScrollChangeSize="{x:Bind ViewModel.SelectedScrollChangeSize, Mode=OneWay}" />
            </i:Interaction.Behaviors>
            <!-- Avalonia theme brushes (SystemAccentColor, ThemeAccentBrush, ThemeControlHigh/LowBrush, ThemeBackgroundBrush): the closest WinUI theme brushes. -->
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Width="120" Height="80" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6" />
              <Border Width="120" Height="80" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="6" />
              <Border Width="120" Height="80" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" CornerRadius="6" />
              <Border Width="120" Height="80" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6" />
              <Border Width="120" Height="80" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" />
              <Border Width="120" Height="80" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" CornerRadius="6" />
              <Border Width="120" Height="80" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="6" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
