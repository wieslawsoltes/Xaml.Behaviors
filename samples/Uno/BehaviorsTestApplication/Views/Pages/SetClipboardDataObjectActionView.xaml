<UserControl x:Class="BehaviorsTestApplication.Views.Pages.SetClipboardDataObjectActionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <Grid>
    <Button x:Name="SetDataButton" Content="Set Clipboard Data Object" Margin="5">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Click" SourceObject="{x:Bind SetDataButton}">
          <!-- WinUI: the view model's data transfer is a DataPackage. -->
          <ic:SetClipboardDataObjectAction DataTransfer="{x:Bind ViewModel.ClipboardDataTransfer}" />
        </ic:EventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
  </Grid>
</UserControl>
