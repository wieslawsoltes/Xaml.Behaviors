<UserControl x:Class="BehaviorsTestApplication.Views.Pages.FocusNextElementActionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:icustom="using:Xaml.Interactions.Custom"
             xmlns:ie="using:Xaml.Interactions.Events"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
    <ScrollViewer>
        <StackPanel Spacing="20" Margin="20">
            <TextBlock Text="FocusNextElementAction" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Press any key in the first box to move focus to the next one (using KeyDownEventTrigger)." />
            <TextBox Text="Press a key here">
                <i:Interaction.Behaviors>
                    <ie:KeyDownEventTrigger>
                        <icustom:FocusNextElementAction />
                    </ie:KeyDownEventTrigger>
                </i:Interaction.Behaviors>
            </TextBox>
            <TextBox Text="Focus lands here" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
