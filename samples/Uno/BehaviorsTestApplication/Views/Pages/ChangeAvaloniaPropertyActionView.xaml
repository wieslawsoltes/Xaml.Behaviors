<UserControl x:Class="BehaviorsTestApplication.Views.Pages.ChangeAvaloniaPropertyActionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:icustom="using:Xaml.Interactions.Custom"
             xmlns:xaml="using:Microsoft.UI.Xaml"
             xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="50*" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="50*" />
    </Grid.ColumnDefinitions>
    <Rectangle x:Name="ChangePropertyRectangle"
               Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
               Margin="5"
               Fill="{StaticResource PinkBrush}"
               Stroke="{StaticResource GrayBrush}"
               StrokeThickness="5" />
    <!--
      Avalonia listens to the routed Button.ClickEvent; WinUI's ButtonBase.Click is a CLR event (no RoutedEvent), so the
      routed UIElement.TappedEvent raised by the button is used instead.
    -->
    <Button x:Name="PinkButton" Content="Pink" Grid.Row="1" Grid.Column="0" Margin="5,0,0,5">
      <i:Interaction.Behaviors>
        <icustom:RoutedEventTriggerBehavior RoutedEvent="{x:Bind xaml:UIElement.TappedEvent}"
                                            RoutingStrategies="Bubble"
                                            SourceInteractive="{x:Bind PinkButton}">
          <icustom:ChangeAvaloniaPropertyAction TargetObject="{x:Bind ChangePropertyRectangle}"
                                                TargetProperty="{x:Bind shapes:Shape.FillProperty}"
                                                Value="{StaticResource PinkBrush}" />
        </icustom:RoutedEventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
    <Button x:Name="YellowButton" Content="Yellow" Grid.Row="1" Grid.Column="2" Margin="0,0,5,5">
      <i:Interaction.Behaviors>
        <icustom:RoutedEventTriggerBehavior RoutedEvent="{x:Bind xaml:UIElement.TappedEvent}"
                                            RoutingStrategies="Bubble"
                                            SourceInteractive="{x:Bind YellowButton}">
          <icustom:ChangeAvaloniaPropertyAction TargetObject="{x:Bind ChangePropertyRectangle}"
                                                TargetProperty="{x:Bind shapes:Shape.FillProperty}"
                                                Value="{StaticResource YellowBrush}" />
        </icustom:RoutedEventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
  </Grid>
</UserControl>
