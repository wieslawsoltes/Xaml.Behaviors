<UserControl x:Class="BehaviorsTestApplication.Views.Pages.PropertyValidationBehaviorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:custom="using:Xaml.Interactions.Custom"
             xmlns:behaviors="using:BehaviorsTestApplication.Behaviors"
             mc:Ignorable="d"
             d:DesignWidth="500"
             d:DesignHeight="300">
  <StackPanel Spacing="12" Margin="16">
    <TextBlock Text="PropertyValidationBehavior applies rules to a avalonia property and surfaces IsValid/Error values." TextWrapping="Wrap" />
    <TextBox Width="260"
             PlaceholderText="Enter at least 3 characters"
             Text="{x:Bind ViewModel.ValidatedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
      <i:Interaction.Behaviors>
        <!--
          PropertyValidationBehavior<TextBox, string> (WinUI XAML has no x:TypeArguments); the closed type validates
          TextBox.TextProperty (Avalonia: Property="{x:Static TextBox.TextProperty}").
        -->
        <behaviors:TextBoxTextPropertyValidationBehavior IsValid="{x:Bind ViewModel.IsTextValid, Mode=TwoWay}"
                                                         Error="{x:Bind ViewModel.TextValidationError, Mode=TwoWay}">
          <custom:RequiredTextValidationRule ErrorMessage="Value is required." />
          <custom:MinLengthValidationRule Length="3" ErrorMessage="Minimum length is 3." />
        </behaviors:TextBoxTextPropertyValidationBehavior>
      </i:Interaction.Behaviors>
    </TextBox>
    <CheckBox Content="Is valid" IsChecked="{x:Bind ViewModel.IsTextValid, Mode=OneWay}" IsEnabled="False" />
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8">
      <TextBlock Text="{x:Bind ViewModel.TextValidationError, Mode=OneWay}"
                 Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                 TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</UserControl>
