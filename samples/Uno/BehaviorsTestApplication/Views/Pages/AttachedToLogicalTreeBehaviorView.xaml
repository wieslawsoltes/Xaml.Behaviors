<UserControl x:Class="BehaviorsTestApplication.Views.Pages.AttachedToLogicalTreeBehaviorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:behaviors="using:BehaviorsTestApplication.Behaviors"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="120">
  <!-- WinUI has no logical tree: the Uno Platform behaviors are attached to the logical tree when the element loads. -->
  <StackPanel Spacing="5">
    <Border x:Name="Target" Background="LightGray" Padding="20">
      <i:Interaction.Behaviors>
        <behaviors:AttachedToLogicalTreeMessageBehavior Target="{x:Bind MessageText}" />
      </i:Interaction.Behaviors>
      <TextBlock Text="Target" />
    </Border>
    <TextBlock x:Name="MessageText" />
  </StackPanel>
</UserControl>
