<UserControl x:Class="BehaviorsTestApplication.Views.Pages.AsyncActionGroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
  <StackPanel Spacing="20" Margin="20">
    <TextBlock Text="AsyncActionGroup &amp; DelayAction" FontSize="20" FontWeight="Bold" />

    <Border BorderBrush="Gray" BorderThickness="1" Padding="10" CornerRadius="5">
      <StackPanel Spacing="10">
        <i:Interaction.Behaviors>
          <ic:EventTriggerBehavior EventName="Click" SourceObject="{x:Bind SequenceButton}">
            <ic:AsyncActionGroup Mode="Sequence">
              <ic:ChangePropertyAction TargetObject="{x:Bind SequenceStatusText}" PropertyName="Text" Value="Step 1" />
              <ic:DelayAction Duration="0:0:1" />
              <ic:ChangePropertyAction TargetObject="{x:Bind SequenceStatusText}" PropertyName="Text" Value="Step 2" />
              <ic:DelayAction Duration="0:0:1" />
              <ic:ChangePropertyAction TargetObject="{x:Bind SequenceStatusText}" PropertyName="Text" Value="Finished" />
            </ic:AsyncActionGroup>
          </ic:EventTriggerBehavior>
        </i:Interaction.Behaviors>
        <TextBlock Text="Sequence Mode" FontWeight="SemiBold" />
        <TextBlock Text="Click the button to start a sequence: Step 1 -> Wait 1s -> Step 2 -> Wait 1s -> Finished" />
        <Button x:Name="SequenceButton" Content="Start Sequence" />
        <TextBlock x:Name="SequenceStatusText" Text="Ready" Foreground="Blue" FontSize="16" />
      </StackPanel>
    </Border>

    <Border BorderBrush="Gray" BorderThickness="1" Padding="10" CornerRadius="5">
      <StackPanel Spacing="10">
        <TextBlock Text="Parallel Mode" FontWeight="SemiBold" />
        <TextBlock Text="Click to start parallel delays. (Not easily visualized here without more complex setup, but useful for firing multiple async tasks at once)" />
        <!-- Parallel execution is harder to demo visually with simple property changes unless we had multiple independent indicators -->
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
