<UserControl x:Class="BehaviorsTestApplication.Views.Pages.ConsoleBeepActionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             xmlns:icustom="using:Xaml.Interactions.Custom"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
    <StackPanel Spacing="10">
        <TextBlock Text="ConsoleBeepAction" FontWeight="Bold" />
        <Button Content="Beep">
            <i:Interaction.Behaviors>
                <ic:EventTriggerBehavior EventName="Click">
                    <icustom:ConsoleBeepAction />
                </ic:EventTriggerBehavior>
            </i:Interaction.Behaviors>
        </Button>
    </StackPanel>
</UserControl>
