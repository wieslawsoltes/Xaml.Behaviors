<UserControl x:Class="BehaviorsTestApplication.Views.Pages.ViewModelPropertyActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             xmlns:icustom="using:Xaml.Interactions.Custom"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <StackPanel Margin="5" Spacing="8">
    <i:Interaction.Behaviors>
      <icustom:SetViewModelPropertyOnLoadBehavior PropertyName="Count" Value="1" />
    </i:Interaction.Behaviors>
    <TextBlock x:Name="CountText" Text="{x:Bind ViewModel.Count, Mode=OneWay}" HorizontalAlignment="Center" />
    <Button Content="Set Count To 5">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Click">
          <icustom:SetViewModelPropertyAction PropertyName="Count" Value="5" />
        </ic:EventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
    <Button Content="Increment Count">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Click">
          <icustom:IncrementViewModelPropertyAction PropertyName="Count" Delta="1" />
        </ic:EventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
    <CheckBox Content="Toggle Loading"
              IsChecked="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
              IsEnabled="False" />
    <Button Content="Toggle Loading">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Click">
          <icustom:ToggleViewModelBooleanAction PropertyName="IsLoading" />
        </ic:EventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
    <Border>
      <i:Interaction.Behaviors>
        <icustom:ViewModelPropertyChangedTrigger PropertyName="Count">
          <ic:ChangePropertyAction TargetObject="{x:Bind CountText}" PropertyName="Text" Value="{x:Bind ViewModel.Count, Mode=OneWay}" />
        </icustom:ViewModelPropertyChangedTrigger>
      </i:Interaction.Behaviors>
    </Border>
  </StackPanel>
</UserControl>
