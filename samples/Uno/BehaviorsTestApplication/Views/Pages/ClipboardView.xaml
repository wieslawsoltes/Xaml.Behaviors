<UserControl x:Class="BehaviorsTestApplication.Views.Pages.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="30*" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="30*" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="30*" />
    </Grid.ColumnDefinitions>
    <Button x:Name="ClearClipboardButton" Content="Clear Clipboard" Grid.Row="0" Grid.Column="0" Margin="5,5,0,5">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Click" SourceObject="{x:Bind ClearClipboardButton}">
          <ic:ClearClipboardAction />
        </ic:EventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
    <Button x:Name="SetClipboardTextButton" Content="Set Clipboard Text" Grid.Row="0" Grid.Column="2" Margin="0,5,0,5">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Click" SourceObject="{x:Bind SetClipboardTextButton}">
          <ic:SetClipboardTextAction Text="Avalonia Xaml Behaviors" />
        </ic:EventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
    <Button x:Name="GetClipboardTextButton" Content="Get Clipboard Text" Grid.Row="0" Grid.Column="4" Margin="0,5,5,5">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Click" SourceObject="{x:Bind GetClipboardTextButton}">
          <ic:GetClipboardTextAction Command="{x:Bind ViewModel.GetClipboardTextCommand}" />
        </ic:EventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
  </Grid>
</UserControl>
