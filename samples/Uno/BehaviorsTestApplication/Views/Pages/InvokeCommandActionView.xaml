<UserControl x:Class="BehaviorsTestApplication.Views.Pages.InvokeCommandActionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             xmlns:reactive="using:System.Reactive"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="30*" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="30*" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="30*" />
    </Grid.ColumnDefinitions>
    <Canvas Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Margin="5" Background="{StaticResource GrayBrush}">
      <!-- Avalonia binds Canvas.Left TwoWay; the ellipse never changes it, so OneWay is equivalent. -->
      <Ellipse Canvas.Left="{x:Bind ViewModel.Position, Mode=OneWay}"
               Canvas.Top="200"
               Fill="{StaticResource RedBrush}"
               Stroke="{StaticResource YellowBrush}"
               StrokeThickness="5"
               Height="100" Width="100" />
    </Canvas>
    <Button x:Name="MoveLeftButton" Content="Move Left" Grid.Row="1" Grid.Column="0" Margin="5,0,0,5">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Click" SourceObject="{x:Bind MoveLeftButton}">
          <ic:InvokeCommandAction Command="{x:Bind ViewModel.MoveLeftCommand}" />
        </ic:EventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
    <Button x:Name="ResetMoveButton" Content="Reset Move" Grid.Row="1" Grid.Column="2" Margin="0,0,0,5">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Click" SourceObject="{x:Bind ResetMoveButton}">
          <!-- Avalonia: {x:Static reactive:Unit.Default}; ReactiveUI 25 commands take System.Reactive.Unit. -->
          <ic:InvokeCommandAction Command="{x:Bind ViewModel.ResetMoveCommand}"
                                  CommandParameter="{x:Bind reactive:Unit.Default}" />
        </ic:EventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
    <Button x:Name="MoveRightButton" Content="Move Right" Grid.Row="1" Grid.Column="4" Margin="0,0,5,5">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Click" SourceObject="{x:Bind MoveRightButton}">
          <ic:InvokeCommandAction Command="{x:Bind ViewModel.MoveRightCommand}" />
        </ic:EventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
  </Grid>
</UserControl>
