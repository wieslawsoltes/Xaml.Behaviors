<UserControl x:Class="BehaviorsTestApplication.Views.Pages.KeyGestureTriggerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             xmlns:icustom="using:Xaml.Interactions.Custom"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="150">
  <!-- Avalonia: Focusable="True" on the Border; WinUI panels and borders cannot take focus, a tab stop inside does. -->
  <Border Padding="20" Background="LightGray">
    <ContentControl IsTabStop="True"
                    UseSystemFocusVisuals="True"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
      <TextBlock Text="Press Ctrl+G" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </ContentControl>
    <i:Interaction.Behaviors>
      <icustom:KeyGestureTrigger Gesture="Ctrl+G">
        <ic:InvokeCommandAction Command="{x:Bind ViewModel.TriggerCommand}" />
      </icustom:KeyGestureTrigger>
    </i:Interaction.Behaviors>
  </Border>
</UserControl>
