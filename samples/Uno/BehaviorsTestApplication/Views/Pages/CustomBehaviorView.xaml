<UserControl x:Class="BehaviorsTestApplication.Views.Pages.CustomBehaviorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:icustom="using:Xaml.Interactions.Custom"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <UserControl.Resources>
    <!--
      Avalonia: the style "Canvas.drag > :is(Control)" gives every child of the canvas a DragControlBehavior. WinUI has
      no selectors: the keyed style is applied to the children (Interaction.BehaviorsTemplate creates one behavior
      collection per element).
    -->
    <Style x:Key="DragControlStyle" TargetType="FrameworkElement">
      <Setter Property="i:Interaction.BehaviorsTemplate">
        <Setter.Value>
          <DataTemplate>
            <i:BehaviorCollectionHost>
              <icustom:DragControlBehavior />
            </i:BehaviorCollectionHost>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <!-- Avalonia DockPanel: the canvas docks left, the grid fills the remaining space. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Canvas Grid.Column="0" Width="300" Height="300" Background="{StaticResource GrayBrush}" Margin="5">
      <Rectangle Style="{StaticResource DragControlStyle}" Fill="Blue" Width="60" Height="40" Canvas.Left="20" Canvas.Top="100" />
      <Ellipse Style="{StaticResource DragControlStyle}" Fill="Red" Width="50" Height="50" Canvas.Left="120" Canvas.Top="30" />
      <TextBlock Style="{StaticResource DragControlStyle}" Text="Hello from Avalonia" Canvas.Left="40" Canvas.Top="200" />
      <Grid Style="{StaticResource DragControlStyle}" Background="Purple" Width="80" Height="70" Canvas.Left="200" Canvas.Top="150" />
    </Canvas>
    <Grid Grid.Column="1" Background="{StaticResource GrayBrush}" Margin="5">
      <Ellipse Fill="{StaticResource RedBrush}"
               Stroke="{StaticResource BlackBrush}"
               Height="125" Width="125"
               StrokeThickness="0"
               HorizontalAlignment="Left">
        <i:Interaction.Behaviors>
          <icustom:DragControlBehavior />
        </i:Interaction.Behaviors>
      </Ellipse>
      <Ellipse Fill="{StaticResource BlueBrush}"
               Stroke="{StaticResource BlackBrush}"
               Height="125" Width="125"
               StrokeThickness="0"
               HorizontalAlignment="Right">
        <i:Interaction.Behaviors>
          <icustom:DragControlBehavior />
        </i:Interaction.Behaviors>
      </Ellipse>
    </Grid>
  </Grid>
</UserControl>
