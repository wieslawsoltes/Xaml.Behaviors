<UserControl x:Class="BehaviorsTestApplication.Views.Pages.MoveElementActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             xmlns:icustom="using:Xaml.Interactions.Custom"
             mc:Ignorable="d"
             d:DesignWidth="600"
             d:DesignHeight="300">
  <Grid ColumnSpacing="16" Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <!-- Avalonia: Grid.Styles with StackPanel and Border selectors; WinUI uses keyed styles. -->
    <Grid.Resources>
      <Style x:Key="PanelStackPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="8" />
      </Style>
      <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="6" />
      </Style>
    </Grid.Resources>

    <StackPanel Grid.Column="0" Style="{StaticResource PanelStackPanelStyle}">
      <TextBlock Text="Panel A" FontWeight="SemiBold" />
      <Border Style="{StaticResource PanelBorderStyle}" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel x:Name="LeftPanel" Spacing="8">
          <TextBlock Text="Start here – click the card to move it to Panel B." TextWrapping="Wrap" />
          <Border x:Name="MovableCard"
                  Style="{StaticResource PanelBorderStyle}"
                  Background="{ThemeResource ControlFillColorTertiaryBrush}"
                  Padding="16"
                  CornerRadius="6">
            <StackPanel Style="{StaticResource PanelStackPanelStyle}">
              <TextBlock Text="Movable card" FontWeight="SemiBold" />
              <Button Content="Move to Panel B">
                <i:Interaction.Behaviors>
                  <ic:EventTriggerBehavior EventName="Click">
                    <icustom:MoveElementToPanelAction TargetPanel="{x:Bind RightPanel}" />
                  </ic:EventTriggerBehavior>
                </i:Interaction.Behaviors>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel Grid.Column="1" Style="{StaticResource PanelStackPanelStyle}">
      <TextBlock Text="Panel B" FontWeight="SemiBold" />
      <Border Style="{StaticResource PanelBorderStyle}" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel x:Name="RightPanel" Spacing="8">
          <TextBlock Text="When the card moves here, use the button to send it back." TextWrapping="Wrap" />
          <Button Content="Move card back" HorizontalAlignment="Left">
            <i:Interaction.Behaviors>
              <ic:EventTriggerBehavior EventName="Click">
                <icustom:MoveElementToPanelAction TargetPanel="{x:Bind LeftPanel}" />
              </ic:EventTriggerBehavior>
            </i:Interaction.Behaviors>
          </Button>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
