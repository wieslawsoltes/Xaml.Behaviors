<UserControl x:Class="BehaviorsTestApplication.Views.Pages.ParallaxBehaviorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:icustom="using:Xaml.Interactions.Custom"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Text="ParallaxBehavior" FontSize="24" FontWeight="Bold" Margin="20" />

    <ScrollViewer Grid.Row="1" x:Name="ParallaxScroller">
      <Grid Height="1000">
        <!-- Background Layer (Slow) -->
        <Canvas>
          <Ellipse Fill="#ecf0f1" Width="100" Height="100" Canvas.Left="50" Canvas.Top="50">
            <i:Interaction.Behaviors>
              <icustom:ParallaxBehavior SourceScrollViewer="{x:Bind ParallaxScroller}" ParallaxRatio="0.8" />
            </i:Interaction.Behaviors>
          </Ellipse>
          <Rectangle Fill="#95a5a6" Width="80" Height="80" Canvas.Left="200" Canvas.Top="500">
            <i:Interaction.Behaviors>
              <icustom:ParallaxBehavior SourceScrollViewer="{x:Bind ParallaxScroller}" ParallaxRatio="0.3" />
            </i:Interaction.Behaviors>
          </Rectangle>
        </Canvas>
        <!-- Avalonia: Canvas.Right="50" Canvas.Top="200" (a WinUI Canvas has no Canvas.Right; the ellipse is aligned right). -->
        <Ellipse Fill="#bdc3c7" Width="150" Height="150"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,200,50,0">
          <i:Interaction.Behaviors>
            <icustom:ParallaxBehavior SourceScrollViewer="{x:Bind ParallaxScroller}" ParallaxRatio="0.5" />
          </i:Interaction.Behaviors>
        </Ellipse>

        <!-- Foreground Content -->
        <StackPanel Spacing="50" Margin="50">
          <TextBlock Text="Scroll down to see parallax effect..." FontSize="20" />
          <Border Height="100" Background="#8e44ad" CornerRadius="5">
            <TextBlock Text="Item 1" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <Border Height="100" Background="#8e44ad" CornerRadius="5">
            <TextBlock Text="Item 2" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <Border Height="100" Background="#8e44ad" CornerRadius="5">
            <TextBlock Text="Item 3" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <Border Height="100" Background="#8e44ad" CornerRadius="5">
            <TextBlock Text="Item 4" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <Border Height="100" Background="#8e44ad" CornerRadius="5">
            <TextBlock Text="Item 5" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
