<UserControl x:Class="BehaviorsTestApplication.Views.Pages.FileDropHandlerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:idd="using:Xaml.Interactions.DragAndDrop"
             xmlns:behaviors="using:BehaviorsTestApplication.Behaviors"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">

  <UserControl.Resources>
    <behaviors:FilesDropHandler x:Key="FilesDropHandler" />
  </UserControl.Resources>

  <!-- Avalonia {DynamicResource SystemAccentColor} (a color converted to a brush): the WinUI accent brush. -->
  <StackPanel Margin="5" Spacing="5">
    <Border Background="Transparent" Padding="20" BorderThickness="1" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
      <i:Interaction.Behaviors>
        <idd:ContextDropBehavior Handler="{StaticResource FilesDropHandler}" />
      </i:Interaction.Behaviors>
      <TextBlock Text="Drop files here" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <Border Background="Transparent" Padding="20" BorderThickness="1" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
      <i:Interaction.Behaviors>
        <idd:FilesDropBehavior Command="{x:Bind ViewModel.OpenFilesCommand}" />
      </i:Interaction.Behaviors>
      <TextBlock Text="Drop files here" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <Border Background="Transparent" Padding="20" BorderThickness="1" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
      <i:Interaction.Behaviors>
        <idd:TextDropBehavior Command="{x:Bind ViewModel.GetClipboardTextCommand}" />
      </i:Interaction.Behaviors>
      <TextBlock Text="Drop text here" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <ListView ItemsSource="{x:Bind ViewModel.FileItems, Mode=OneWay}" />
  </StackPanel>
</UserControl>
