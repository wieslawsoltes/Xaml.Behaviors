<UserControl x:Class="BehaviorsTestApplication.Views.Pages.ChangePropertyActionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:ic="using:Xaml.Interactions.Core"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="50*" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="50*" />
    </Grid.ColumnDefinitions>
    <Rectangle x:Name="ChangePropertyRectangle"
               Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
               Margin="5"
               Fill="{StaticResource PinkBrush}"
               Stroke="{StaticResource GrayBrush}"
               StrokeThickness="5" />
    <Button x:Name="PinkButton" Content="Pink" Grid.Row="1" Grid.Column="0" Margin="5,0,0,5">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Click" SourceObject="{x:Bind PinkButton}">
          <ic:ChangePropertyAction TargetObject="{x:Bind ChangePropertyRectangle}"
                                   PropertyName="Fill"
                                   Value="{StaticResource PinkBrush}" />
        </ic:EventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
    <Button x:Name="YellowButton" Content="Yellow" Grid.Row="1" Grid.Column="2" Margin="0,0,5,5">
      <i:Interaction.Behaviors>
        <ic:EventTriggerBehavior EventName="Click" SourceObject="{x:Bind YellowButton}">
          <ic:ChangePropertyAction TargetObject="{x:Bind ChangePropertyRectangle}"
                                   PropertyName="Fill"
                                   Value="{StaticResource YellowBrush}" />
        </ic:EventTriggerBehavior>
      </i:Interaction.Behaviors>
    </Button>
  </Grid>
</UserControl>
