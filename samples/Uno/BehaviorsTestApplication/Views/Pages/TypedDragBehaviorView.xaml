<UserControl x:Class="BehaviorsTestApplication.Views.Pages.TypedDragBehaviorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Xaml.Interactivity"
             xmlns:idd="using:Xaml.Interactions.DragAndDrop"
             xmlns:behaviors="using:BehaviorsTestApplication.Behaviors"
             xmlns:vm="using:BehaviorsTestApplication.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450">

  <!--
    Avalonia: the ListBox.TypedDragAndDrop style sets the drop behavior of the list and the ListBoxItem style the drag
    behavior of every item (BehaviorCollectionTemplate). WinUI has no style classes: the list (ListView) declares its
    behaviors and its ItemContainerStyle creates the item behaviors from Interaction.BehaviorsTemplate.
  -->
  <UserControl.Resources>
    <behaviors:ItemsListBoxDropHandler x:Key="ItemsListBoxDropHandler" />
  </UserControl.Resources>

  <ListView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
    <i:Interaction.Behaviors>
      <idd:ContextDropBehavior Handler="{StaticResource ItemsListBoxDropHandler}" />
    </i:Interaction.Behaviors>
    <ListView.ItemContainerStyle>
      <Style TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="i:Interaction.BehaviorsTemplate">
          <Setter.Value>
            <DataTemplate>
              <i:BehaviorCollectionHost>
                <idd:TypedDragBehavior DataType="vm:DragItemViewModel" />
              </i:BehaviorCollectionHost>
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ListView.ItemContainerStyle>
    <ListView.ItemTemplate>
      <DataTemplate x:DataType="vm:DragItemViewModel">
        <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
      </DataTemplate>
    </ListView.ItemTemplate>
  </ListView>
</UserControl>
