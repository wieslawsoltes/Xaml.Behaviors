<Application x:Class="AnimationsTestApplication.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:AnimationsTestApplication.Controls"
             RequestedTheme="Light">
  <!-- Twin of App.axaml: the Fluent theme (XamlControlsResources), the sidebar styles and the Button style. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary Source="ms-appx:///SideBar.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
      </Style>
      <!--
        Avalonia's TabControl has no add or close buttons; the WinUI tab control (TabView) used for the page tabs is
        configured the same way.
      -->
      <Style TargetType="TabView">
        <Setter Property="IsAddTabButtonVisible" Value="False" />
        <Setter Property="CanDragTabs" Value="False" />
        <Setter Property="CanReorderTabs" Value="False" />
        <Setter Property="TabWidthMode" Value="SizeToContent" />
        <!-- Like the Avalonia TabControl, the selected content fills the content area. -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
      </Style>
      <Style TargetType="TabViewItem">
        <Setter Property="IsClosable" Value="False" />
      </Style>
      <!--
        The demo controls are content controls: Avalonia stretches the content by default, WinUI aligns it to the
        top left.
      -->
      <Style x:Key="DemoControlStyle" TargetType="ContentControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
      </Style>
      <Style TargetType="controls:FluidMoveAnimationDemoControl" BasedOn="{StaticResource DemoControlStyle}" />
      <Style TargetType="controls:KeyFrameAnimationDemoControl" BasedOn="{StaticResource DemoControlStyle}" />
      <Style TargetType="controls:OrbitAnimationDemoControl" BasedOn="{StaticResource DemoControlStyle}" />
      <Style TargetType="controls:ParallaxAnimationDemoControl" BasedOn="{StaticResource DemoControlStyle}" />
      <Style TargetType="controls:TiltAnimationDemoControl" BasedOn="{StaticResource DemoControlStyle}" />
      <Style TargetType="controls:TransitionOperationsDemoControl" BasedOn="{StaticResource DemoControlStyle}" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
