<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:AnimationsTestApplication.Controls"
             xmlns:sys="using:System"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="AnimationsTestApplication.Views.Pages.TransitionOperationsView"
             mc:Ignorable="d"
             d:DesignWidth="850"
             d:DesignHeight="600">
  <StackPanel Margin="28" Spacing="20">
    <TextBlock Text="Transition operations" FontSize="24" FontWeight="SemiBold" />
    <TextBlock Text="Click the card to transition its opacity. The sample observes, adds, and removes DoubleTransition through TransitionOperations."
               TextWrapping="Wrap" />
    <!-- Uno only: WinUI has no DoubleTransition (see TransitionOperationsDemoControl). -->
    <TextBlock Text="Uno Platform: WinUI transition collections only hold theme transitions, so the sample adds and removes an EntranceThemeTransition through TransitionOperations and animates the opacity change with a storyboard (UIElement.OpacityTransition is not implemented on Uno Platform)."
               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
               TextWrapping="Wrap" />
    <controls:TransitionOperationsDemoControl x:Name="TransitionDemo"
                                              Width="340"
                                              Height="220"
                                              HorizontalAlignment="Center"
                                              IsTabStop="True">
      <Border Background="#FFCDD2" CornerRadius="18" Padding="28">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <TextBlock Text="Click to transition" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="Opacity 1.0 ↔ 0.25" />
          <!-- Compiled binding to the named demo control (Avalonia: $parent[...] with StringFormat). -->
          <TextBlock Text="{x:Bind sys:String.Format('Observed collection values: {0}', TransitionDemo.TransitionChangeCount), Mode=OneWay}" />
        </StackPanel>
      </Border>
    </controls:TransitionOperationsDemoControl>
  </StackPanel>
</UserControl>
