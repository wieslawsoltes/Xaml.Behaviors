<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:custom="using:Xaml.Interactions.Custom"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AnimationsTestApplication.Views.Pages.SlidingAnimationView">
  <!-- Avalonia's default XAML namespace maps the animation types; WinUI XAML uses the custom: namespace. -->
  <TabView>
    <TabViewItem Header="Left">
      <!-- Avalonia ClipToBounds: a non-scrolling ScrollViewer clips its content on WinUI. -->
      <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Border x:Name="Border1"
                Background="Transparent"
                custom:SlidingAnimation.Left="500">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
            <TextBlock Text="TextBlock"/>
            <CheckBox IsChecked="True" Content="CheckBox" />
            <TextBlock Text="TextBlock"/>
            <TextBox Text="TextBox"/>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </TabViewItem>
    <TabViewItem Header="Right">
      <!-- Avalonia ClipToBounds: a non-scrolling ScrollViewer clips its content on WinUI. -->
      <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Border x:Name="Border2"
                Background="Transparent"
                custom:SlidingAnimation.Right="500">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
            <TextBlock Text="TextBlock"/>
            <CheckBox IsChecked="True" Content="CheckBox" />
            <TextBlock Text="TextBlock"/>
            <TextBox Text="TextBox"/>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </TabViewItem>
    <TabViewItem Header="Top">
      <!-- Avalonia ClipToBounds: a non-scrolling ScrollViewer clips its content on WinUI. -->
      <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Border x:Name="Border3"
                Background="Transparent"
                custom:SlidingAnimation.Top="500">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
            <TextBlock Text="TextBlock"/>
            <CheckBox IsChecked="True" Content="CheckBox" />
            <TextBlock Text="TextBlock"/>
            <TextBox Text="TextBox"/>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </TabViewItem>
    <TabViewItem Header="Bottom">
      <!-- Avalonia ClipToBounds: a non-scrolling ScrollViewer clips its content on WinUI. -->
      <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Border x:Name="Border4"
                Background="Transparent"
                custom:SlidingAnimation.Bottom="500">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
            <TextBlock Text="TextBlock"/>
            <CheckBox IsChecked="True" Content="CheckBox" />
            <TextBlock Text="TextBlock"/>
            <TextBox Text="TextBox"/>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </TabViewItem>
  </TabView>
</UserControl>
