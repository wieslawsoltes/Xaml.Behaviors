<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:AnimationsTestApplication.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="AnimationsTestApplication.Views.Pages.FluidMoveAnimationView"
             mc:Ignorable="d"
             d:DesignWidth="850"
             d:DesignHeight="600">
  <StackPanel Margin="28" Spacing="20">
    <TextBlock Text="Fluid move animation" FontSize="24" FontWeight="SemiBold" />
    <TextBlock Text="Click the card to let FluidMoveAnimation prepare its transform and run directly on the control."
               TextWrapping="Wrap" />
    <Border Background="#F5F5F5" CornerRadius="14">
      <!-- Avalonia ClipToBounds: a non-scrolling ScrollViewer clips its content on WinUI. -->
      <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid Padding="40">
          <controls:FluidMoveAnimationDemoControl Width="280"
                                                  Height="180"
                                                  HorizontalAlignment="Center"
                                                  IsTabStop="True">
            <Border Background="#FFE0B2" CornerRadius="14">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="FluidMoveAnimation.TryRun" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="Click to animate from alternating offsets" />
              </StackPanel>
            </Border>
          </controls:FluidMoveAnimationDemoControl>
        </Grid>
      </ScrollViewer>
    </Border>
  </StackPanel>
</UserControl>
