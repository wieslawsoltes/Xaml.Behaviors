<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:AnimationsTestApplication.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="AnimationsTestApplication.Views.Pages.ParallaxAnimationView"
             x:DataType="x:Object"
             mc:Ignorable="d"
             d:DesignWidth="850"
             d:DesignHeight="600">
  <Grid RowDefinitions="Auto,Auto,*" Margin="28">
    <TextBlock Text="Parallax composition effect" FontSize="24" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1"
               Margin="0,10,0,18"
               Text="Scroll the content. The cards subscribe to the ScrollViewer offset and call ParallaxAnimation.Apply directly."
               TextWrapping="Wrap" />
    <ScrollViewer x:Name="ParallaxScroller" Grid.Row="2">
      <StackPanel Spacing="70" Margin="20,30,20,220">
        <controls:ParallaxAnimationDemoControl Source="{Binding #ParallaxScroller}"
                                               Ratio="0.15"
                                               Height="150">
          <Border Background="#FFE0B2" CornerRadius="14" Padding="24">
            <TextBlock Text="Ratio 0.15" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </controls:ParallaxAnimationDemoControl>
        <controls:ParallaxAnimationDemoControl Source="{Binding #ParallaxScroller}"
                                               Ratio="0.35"
                                               Height="150">
          <Border Background="#D1C4E9" CornerRadius="14" Padding="24">
            <TextBlock Text="Ratio 0.35" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </controls:ParallaxAnimationDemoControl>
        <controls:ParallaxAnimationDemoControl Source="{Binding #ParallaxScroller}"
                                               Ratio="-0.12"
                                               Height="150">
          <Border Background="#B2DFDB" CornerRadius="14" Padding="24">
            <TextBlock Text="Ratio -0.12" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </controls:ParallaxAnimationDemoControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
